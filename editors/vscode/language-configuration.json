{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "autoCloseBefore": ";:.,=}])> \n\t",
  "folding": {
    "markers": {
      "start": "^\\s*//\\s*#?region\\b",
      "end": "^\\s*//\\s*#?endregion\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^.*(\\{[^}\"]*\\s*|\\([^)\"]*\\s*|\\[[^\\]\"]*\\s*)$",
    "decreaseIndentPattern": "^\\s*[}\\]\\)].*$"
  },
  "wordPattern": "#[0-9a-fA-F]{3,8}\\b|%[0-9]+\\b|[a-zA-Z_][a-zA-Z0-9_]*"
}
