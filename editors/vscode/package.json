{
  "name": "knr-lang",
  "displayName": "knr Language Support (.tsk)",
  "description": "First-class Strict TypeScript/TSX (.tsk), .knr, and SSA IR language support powered exclusively by `knr lsp` — zero conflict with tsserver.",
  "version": "0.4.0",
  "publisher": "knr-lang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "knr",
    "tsk",
    "tsx",
    "typescript",
    "ssa",
    "linear",
    "shader",
    "wgsl",
    "lsp"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:knr",
    "onLanguage:knr-ssa"
  ],
  "contributes": {
    "languages": [
      {
        "id": "knr",
        "aliases": [
          "knr (.tsk)",
          "tsk",
          "knr",
          "KNR"
        ],
        "extensions": [
          ".tsk",
          ".knr"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "knr-ssa",
        "aliases": [
          "knr SSA",
          "knr-ssa"
        ],
        "extensions": [
          ".ssa",
          ".ssa.schema"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "knr",
        "scopeName": "source.tsk",
        "path": "./syntaxes/knr.tmLanguage.json"
      },
      {
        "language": "knr-ssa",
        "scopeName": "source.tsk",
        "path": "./syntaxes/knr.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "knr.restartServer",
        "title": "knr: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "knr",
      "properties": {
        "knr.serverPath": {
          "type": "string",
          "default": "knr",
          "description": "Path to the knr CLI executable used to start the built-in Language Server (`knr lsp`)."
        },
        "knr.serverArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "description": "Command-line arguments passed to `knr.serverPath` when spawning the Language Server."
        },
        "knr.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Controls LSP protocol logging in the knr Language Server output channel."
        }
      }
    }
  }
}
