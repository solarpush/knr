{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "knr",
  "scopeName": "source.knr",
  "fileTypes": [
    "knr",
    "ssa",
    "ssa.schema"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#hex-colors"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#effects"
    },
    {
      "include": "#types"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#ssa-tokens"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.knr",
          "match": "(//).*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.knr"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.knr",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.knr"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.knr"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.knr",
              "match": "\\\\(?:[nrt0\\\\\"']|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})"
            },
            {
              "name": "invalid.illegal.escape.knr",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "hex-colors": {
      "patterns": [
        {
          "name": "constant.other.color.rgb-value.knr",
          "match": "#[0-9a-fA-F]{3,8}\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(shader)\\s+(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.shader.knr"
            },
            "2": {
              "name": "keyword.declaration.function.knr"
            },
            "3": {
              "name": "entity.name.function.shader.knr"
            }
          }
        },
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.knr"
            },
            "2": {
              "name": "entity.name.function.knr"
            }
          }
        },
        {
          "match": "\\b(schema|struct)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.struct.knr"
            },
            "2": {
              "name": "entity.name.type.struct.knr"
            }
          }
        },
        {
          "match": "\\b(enum)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.enum.knr"
            },
            "2": {
              "name": "entity.name.type.enum.knr"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.knr",
          "match": "\\b(import|return|if|else|while|break|continue|match)\\b"
        },
        {
          "name": "keyword.other.knr",
          "match": "\\b(shader|fn|schema|struct|enum|let|effects|syscall|spawn)\\b"
        }
      ]
    },
    "effects": {
      "patterns": [
        {
          "name": "support.type.effect.knr",
          "match": "\\b(Net|Ui|Hw|Async)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.knr",
          "match": "\\b(i64|f64|bool|str|buf|void)\\b"
        },
        {
          "name": "support.type.generic.knr",
          "match": "\\b(vec|map|chan)\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.knr",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.knr",
          "match": "(?<!\\.)\\b(sin|cos|tan|sqrt|abs|floor|ceil|fract|pow|atan2|min|max|clamp|lerp|mix|smoothstep|to_f64|to_i64|to_str|str_len|vec_new|vec_push|vec_get|vec_len|map_new|map_set|map_get|buf_alloc|buf_read|buf_write|chan_new|chan_send|chan_recv|free)\\b(?=\\s*\\()"
        }
      ]
    },
    "ssa-tokens": {
      "patterns": [
        {
          "name": "variable.other.register.knr",
          "match": "(?<![a-zA-Z0-9_)\\]])%[0-9]+\\b"
        },
        {
          "name": "entity.name.label.knr",
          "match": "\\bbb[0-9]+\\b(?=\\s*[:(])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.knr",
          "match": "\\b[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.hexadecimal.knr",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.integer.decimal.knr",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.spread.knr",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.arrow.knr",
          "match": "->|=>"
        },
        {
          "name": "punctuation.accessor.namespace.knr",
          "match": "::"
        },
        {
          "name": "keyword.operator.logical.knr",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.comparison.knr",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.borrow.knr",
          "match": "&(?!&)"
        },
        {
          "name": "keyword.operator.assignment.knr",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.knr",
          "match": "[+\\-*/%]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "match": "\\b([A-Z][a-zA-Z0-9_]*)(::)([A-Z][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "entity.name.type.enum.knr"
            },
            "2": {
              "name": "punctuation.accessor.namespace.knr"
            },
            "3": {
              "name": "variable.other.enummember.knr"
            }
          }
        },
        {
          "name": "entity.name.type.knr",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "match": "\\b([a-z_][a-zA-Z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.knr"
            }
          }
        }
      ]
    }
  }
}
