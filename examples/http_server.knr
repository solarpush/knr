// Full-stack Native Compiled HTTP Server in .knr!
// Zero raw HTML strings — renders typed declarative UiNode trees server-side
// via `syscall Ui "ui.render"` and handles live SSR button clicks over Tokio TCP.
//
// Build standalone native ELF binary:
//   knr build examples/http_server.knr --target native -o ./http_server
// Run (binds http://127.0.0.1:8080, override with KNR_PORT=3000):
//   ./http_server

import "./http_types.knr";
import "./ui.knr";

fn build_dashboard(count: i64, step: i64, reqs: i64, last_route: str) -> UiNode {
    let badge = ui_badge("knr Native ELF · Cranelift + Tokio · Zero GC", "#0f172a", "#38bdf8");
    let title = ui_text("knr Full-Stack Native Server", 30, "#f8fafc");
    let subtitle = ui_text(
        "100% compiled to native x86_64 machine code — typed UiNode SSR with zero raw HTML",
        14,
        "#94a3b8",
    );

    // Counter hero card
    let counter_val = ui_text("Count: " + to_str(count), 48, "#38bdf8");
    let meta = ui_text(
        "Active step: x" + to_str(step) + "  ·  Requests served: " + to_str(reqs) + "  ·  Last route: " + last_route,
        14,
        "#cbd5e1",
    );

    let act_btns: vec[UiNode] = vec_new();
    act_btns = vec_push(act_btns, ui_button("- Decrease", "/ui/dec", "#334155", "#f8fafc"));
    act_btns = vec_push(act_btns, ui_button("+ Increase", "/ui/inc", "#0284c7", "#ffffff"));
    act_btns = vec_push(act_btns, ui_button("Reset", "/ui/reset", "#dc2626", "#ffffff"));
    let act_row = ui_row(0, 12, act_btns);

    let bg1 = if step == 1 { "#0f766e" } else { "#1e293b" };
    let bg5 = if step == 5 { "#0f766e" } else { "#1e293b" };
    let bg10 = if step == 10 { "#0f766e" } else { "#1e293b" };
    let step_btns: vec[UiNode] = vec_new();
    step_btns = vec_push(step_btns, ui_button("Step x1", "/ui/step1", bg1, "#e2e8f0"));
    step_btns = vec_push(step_btns, ui_button("Step x5", "/ui/step5", bg5, "#e2e8f0"));
    step_btns = vec_push(step_btns, ui_button("Step x10", "/ui/step10", bg10, "#e2e8f0"));
    let step_row = ui_row(0, 10, step_btns);

    let main_card_kids: vec[UiNode] = vec_new();
    main_card_kids = vec_push(main_card_kids, badge);
    main_card_kids = vec_push(main_card_kids, title);
    main_card_kids = vec_push(main_card_kids, subtitle);
    main_card_kids = vec_push(main_card_kids, counter_val);
    main_card_kids = vec_push(main_card_kids, meta);
    main_card_kids = vec_push(main_card_kids, act_row);
    main_card_kids = vec_push(main_card_kids, step_row);
    let main_card = ui_card(28, 16, "#111827", "#1e293b", main_card_kids);

    // Endpoints info card
    let api_title = ui_text("Live Native Routes", 18, "#f8fafc");
    let r1 = ui_text("GET  /           -> Typed UiNode SSR dashboard (live hot-swap)", 13, "#94a3b8");
    let r2 = ui_text("POST /ui/*       -> Mutate server state & re-render UiNode tree", 13, "#94a3b8");
    let r3 = ui_text("POST /api/inc    -> JSON API {\"count\": N}", 13, "#94a3b8");
    let r4 = ui_text("GET  /count      -> Plain-text counter value", 13, "#94a3b8");

    let api_kids: vec[UiNode] = vec_new();
    api_kids = vec_push(api_kids, api_title);
    api_kids = vec_push(api_kids, r1);
    api_kids = vec_push(api_kids, r2);
    api_kids = vec_push(api_kids, r3);
    api_kids = vec_push(api_kids, r4);
    let api_card = ui_card(22, 8, "#0f172a", "#1e293b", api_kids);

    let root_kids: vec[UiNode] = vec_new();
    root_kids = vec_push(root_kids, main_card);
    root_kids = vec_push(root_kids, api_card);
    return ui_col(16, 20, "", root_kids);
}

fn render_page(count: i64, step: i64, reqs: i64, last_route: str) -> str effects(Ui) {
    let tree = build_dashboard(count, step, reqs, last_route);
    let html: str = syscall Ui "ui.render" tree;
    return html;
}

fn main() -> i64 effects(Net, Ui) {
    // Listens on http://127.0.0.1:8080 by default (override via KNR_PORT env var)
    let srv: i64 = syscall Net "net.listen" 8080;
    let count: i64 = 0;
    let step: i64 = 1;
    let reqs: i64 = 0;
    let running: bool = true;

    while running {
        let req: HttpRequest = syscall Net "net.wait_req" srv;
        let route: Route = classify_route(&req);
        let req_id: i64 = req.req_id;
        let req_path: str = req.path;
        reqs = reqs + 1;

        match route {
            Route::Home => {
                let body = render_page(count, step, reqs, req_path);
                let resp = HttpResponse { req_id: req_id, status: 200, body: body };
                let ok: bool = syscall Net "net.respond" resp;
            }
            Route::UiInc => {
                count = count + step;
                let body = render_page(count, step, reqs, req_path);
                let resp = HttpResponse { req_id: req_id, status: 200, body: body };
                let ok: bool = syscall Net "net.respond" resp;
            }
            Route::UiDec => {
                count = count - step;
                let body = render_page(count, step, reqs, req_path);
                let resp = HttpResponse { req_id: req_id, status: 200, body: body };
                let ok: bool = syscall Net "net.respond" resp;
            }
            Route::UiReset => {
                count = 0;
                let body = render_page(count, step, reqs, req_path);
                let resp = HttpResponse { req_id: req_id, status: 200, body: body };
                let ok: bool = syscall Net "net.respond" resp;
            }
            Route::UiStep1 => {
                step = 1;
                let body = render_page(count, step, reqs, req_path);
                let resp = HttpResponse { req_id: req_id, status: 200, body: body };
                let ok: bool = syscall Net "net.respond" resp;
            }
            Route::UiStep5 => {
                step = 5;
                let body = render_page(count, step, reqs, req_path);
                let resp = HttpResponse { req_id: req_id, status: 200, body: body };
                let ok: bool = syscall Net "net.respond" resp;
            }
            Route::UiStep10 => {
                step = 10;
                let body = render_page(count, step, reqs, req_path);
                let resp = HttpResponse { req_id: req_id, status: 200, body: body };
                let ok: bool = syscall Net "net.respond" resp;
            }
            Route::ApiInc => {
                count = count + step;
                let body = "{\"count\":" + to_str(count) + "}";
                let resp = HttpResponse { req_id: req_id, status: 200, body: body };
                let ok: bool = syscall Net "net.respond" resp;
            }
            Route::Count => {
                let body = to_str(count);
                let resp = HttpResponse { req_id: req_id, status: 200, body: body };
                let ok: bool = syscall Net "net.respond" resp;
            }
            Route::Shutdown => {
                let resp = HttpResponse { req_id: req_id, status: 200, body: "bye" };
                let ok: bool = syscall Net "net.respond" resp;
                running = false;
            }
            Route::NotFound => {
                let resp = HttpResponse { req_id: req_id, status: 404, body: "not found" };
                let ok: bool = syscall Net "net.respond" resp;
            }
        }
    }

    return count;
}
