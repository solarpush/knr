// ============================================================================
// knr 3D SDF Raymarching Flagship Demo — 100% Pure `.knr`
// ============================================================================
// Zero raw HTML, zero raw CSS, zero raw GLSL/WGSL, zero relative imports!
//
// Run natively on GPU (wgpu Vulkan/Metal/DX12, auto CPU fallback):
//   knr run examples/raymarch_3d.knr --gui
// Export to standalone WebAssembly + WebGPU / WebGL2 browser app:
//   knr build examples/raymarch_3d.knr --target web -o dist_raymarch/
// Run built-in deterministic unit tests:
//   knr test examples/raymarch_3d.knr

import "std/ui";
import "std/math";

// ============================================================================
// 1. REAL 3D SIGNED DISTANCE FIELD (SDF) GEOMETRY & GPU RAYMARCHING KERNEL
//    Statically verified GPU-pure (`knr-verify`) and compiled via `naga` to:
//    - WGSL (Desktop `wgpu` + Browser WebGPU)
//    - GLSL ES 3.00 (Universal Browser WebGL2 fallback)
// ============================================================================

fn sd_torus(px: f64, py: f64, pz: f64, major: f64, minor: f64) -> f64 {
    let qx = sqrt(px * px + pz * pz) - major;
    return sqrt(qx * qx + py * py) - minor;
}

fn sd_sphere(px: f64, py: f64, pz: f64, radius: f64) -> f64 {
    return sqrt(px * px + py * py + pz * pz) - radius;
}

fn scene_sdf(px: f64, py: f64, pz: f64, time: f64, twist: f64) -> f64 {
    // Live controllable axial twist deformation
    let twist_amt = twist * 2.2;
    let ta = py * twist_amt;
    let ct = cos(ta);
    let st = sin(ta);
    let tx = px * ct - pz * st;
    let tz = px * st + pz * ct;

    // Rotating sculptural torus around X and Y axes
    let ax = time * 0.72;
    let ay = time * 0.54;
    let cx = cos(ax);
    let sx = sin(ax);
    let cy = cos(ay);
    let sy = sin(ay);

    let ry1 = py * cx - tz * sx;
    let rz1 = py * sx + tz * cx;
    let rx2 = tx * cy + rz1 * sy;
    let rz2 = rz1 * cy - tx * sy;
    let d_torus = sd_torus(rx2, ry1, rz2, 0.88, 0.27);

    // Orbiting morphing spheres blended into the torus via smooth minimum (`smin`)
    let ox1 = cos(time * 1.15) * 0.92;
    let oy1 = sin(time * 1.55) * 0.42;
    let oz1 = sin(time * 1.15) * 0.92;
    let d_orb1 = sd_sphere(px - ox1, py - oy1, pz - oz1, 0.36);

    let ox2 = cos(time * 0.85 + pi()) * 0.78;
    let oy2 = cos(time * 1.30) * 0.48;
    let oz2 = sin(time * 0.85 + pi()) * 0.78;
    let d_orb2 = sd_sphere(px - ox2, py - oy2, pz - oz2, 0.28);

    // Breathing central energy core
    let d_core = sd_sphere(px, py, pz, 0.34 + 0.06 * sin(time * 2.2));

    let d_blend1 = smin(d_torus, d_orb1, 0.42);
    let d_blend2 = smin(d_blend1, d_orb2, 0.38);
    return smin(d_blend2, d_core, 0.35);
}

shader fn raymarch_scene(
    uv: Vec2,
    time: f64,
    mouse: Vec2,
    twist: f64,
    glow: f64,
    zoom: f64,
) -> Color {
    // Aspect-compensated normalized viewport coordinates (+Y up)
    let sx = (uv.x - 0.5) * 2.2;
    let sy = (0.5 - uv.y) * 1.25;

    // Interactive mouse-orbit spherical camera around origin
    let yaw = (mouse.x - 0.5) * tau() * 0.75 + time * 0.18;
    let pitch = clamp((mouse.y - 0.5) * 1.35, -0.95, 0.95);
    let cam_dist = 3.8 - zoom * 1.55;

    let cp = cos(pitch);
    let sp = sin(pitch);
    let cy = cos(yaw);
    let sy_ang = sin(yaw);

    let ro = Vec3 {
        x: cam_dist * cp * sy_ang,
        y: cam_dist * sp,
        z: cam_dist * cp * cy,
    };

    // Orthonormal look-at camera basis (forward, right, up)
    let neg_ro = Vec3 {
        x: 0.0 - ro.x,
        y: 0.0 - ro.y,
        z: 0.0 - ro.z,
    };
    let fwd = vec3_norm(&neg_ro);
    let right_raw = Vec3 {
        x: 0.0 - fwd.z,
        y: 0.0,
        z: fwd.x,
    };
    let right = vec3_norm(&right_raw);
    let up = Vec3 {
        x: right.y * fwd.z - right.z * fwd.y,
        y: right.z * fwd.x - right.x * fwd.z,
        z: right.x * fwd.y - right.y * fwd.x,
    };

    let focal = 1.45;
    let rd_raw = Vec3 {
        x: fwd.x * focal + right.x * sx + up.x * sy,
        y: fwd.y * focal + right.y * sx + up.y * sy,
        z: fwd.z * focal + right.z * sx + up.z * sy,
    };
    let rd = vec3_norm(&rd_raw);

    let ro_x = ro.x;
    let ro_y = ro.y;
    let ro_z = ro.z;
    let rd_x = rd.x;
    let rd_y = rd.y;
    let rd_z = rd.z;

    // 48-step sphere tracing with volumetric proximity glow accumulation
    let t = 0.0;
    let glow_acc = 0.0;
    let hit = 0.0;
    let step = 0;

    while step < 48 {
        let px = ro_x + rd_x * t;
        let py = ro_y + rd_y * t;
        let pz = ro_z + rd_z * t;
        let d = scene_sdf(px, py, pz, time, twist);
        glow_acc = glow_acc + 0.014 / (abs(d) + 0.055);
        if d < 0.0025 {
            hit = 1.0;
            break;
        }
        t = t + d * 0.82;
        if t > 9.5 {
            break;
        }
        step = step + 1;
    }

    // Finite-difference 3D surface normal estimation at intersection point
    let hx = ro_x + rd_x * t;
    let hy = ro_y + rd_y * t;
    let hz = ro_z + rd_z * t;
    let eps = 0.002;
    let nx = scene_sdf(hx + eps, hy, hz, time, twist) - scene_sdf(hx - eps, hy, hz, time, twist);
    let ny = scene_sdf(hx, hy + eps, hz, time, twist) - scene_sdf(hx, hy - eps, hz, time, twist);
    let nz = scene_sdf(hx, hy, hz + eps, time, twist) - scene_sdf(hx, hy, hz - eps, time, twist);
    let n_raw = Vec3 { x: nx, y: ny, z: nz };
    let n = vec3_norm(&n_raw);

    // Dual-light diffuse + Blinn-Phong specular + Fresnel rim lighting
    let l1_raw = Vec3 { x: 0.65, y: 0.82, z: 0.55 };
    let l1 = vec3_norm(&l1_raw);
    let l2_raw = Vec3 { x: -0.75, y: 0.25, z: -0.60 };
    let l2 = vec3_norm(&l2_raw);
    let view_dir = Vec3 {
        x: 0.0 - rd_x,
        y: 0.0 - rd_y,
        z: 0.0 - rd_z,
    };

    let diff1 = max(vec3_dot(&n, &l1), 0.0);
    let diff2 = max(vec3_dot(&n, &l2), 0.0);

    let h_sum = vec3_add(&l1, &view_dir);
    let half_v = vec3_norm(&h_sum);
    let nh = max(vec3_dot(&n, &half_v), 0.0);
    let spec2 = nh * nh;
    let spec4 = spec2 * spec2;
    let spec8 = spec4 * spec4;
    let spec16 = spec8 * spec8;
    let spec = spec16 * spec16;

    let nv = clamp(vec3_dot(&n, &view_dir), 0.0, 1.0);
    let fres1 = 1.0 - nv;
    let fres = fres1 * fres1 * fres1;

    // Iridescent cosine palette driven by 3D surface normal & time
    let phase = n.y * 0.45 + n.x * 0.25 + time * 0.14;
    let pal_r = 0.45 + 0.45 * cos(tau() * (phase + 0.05));
    let pal_g = 0.50 + 0.45 * cos(tau() * (phase + 0.28));
    let pal_b = 0.62 + 0.38 * cos(tau() * (phase + 0.56));

    let surf_r = pal_r * (0.14 + diff1 * 0.72) + diff2 * 0.24 + spec * 0.85 + fres * 0.35;
    let surf_g = pal_g * (0.16 + diff1 * 0.78) + diff2 * 0.12 + spec * 0.90 + fres * 0.68;
    let surf_b = pal_b * (0.24 + diff1 * 0.86) + diff2 * 0.42 + spec * 1.00 + fres * 0.95;

    // Deep cosmic backdrop gradient + additive volumetric SDF glow
    let bg_grad = clamp(1.0 - uv.y, 0.0, 1.0);
    let bg_r = 0.03 + bg_grad * 0.05;
    let bg_g = 0.05 + bg_grad * 0.08;
    let bg_b = 0.11 + bg_grad * 0.16;

    let g_pow = glow_acc * (0.12 + glow * 0.55);
    let glow_r = g_pow * 0.28;
    let glow_g = g_pow * 0.72;
    let glow_b = g_pow * 1.05;

    // Subtle cinematic vignette
    let vdx = uv.x - 0.5;
    let vdy = uv.y - 0.5;
    let vig = clamp(1.0 - (vdx * vdx + vdy * vdy) * 0.85, 0.45, 1.0);

    let r = clamp((lerp(bg_r, surf_r, hit) + glow_r) * vig, 0.0, 1.0);
    let g = clamp((lerp(bg_g, surf_g, hit) + glow_g) * vig, 0.0, 1.0);
    let b = clamp((lerp(bg_b, surf_b, hit) + glow_b) * vig, 0.0, 1.0);
    return Color { r: r, g: g, b: b, a: 1.0 };
}

// ============================================================================
// 2. MVU APPLICATION STATE, 60/120 FPS TICK, AND INTERACTIVE EVENT HANDLERS
// ============================================================================

schema State {
    0: preset_idx i64,
    1: twist f64,
    2: glow f64,
    3: zoom f64,
    4: paused bool,
    5: elapsed f64,
    6: smooth_glow f64,
}

fn init() -> State {
    return State {
        preset_idx: 0,
        twist: 0.35,
        glow: 0.62,
        zoom: 0.45,
        paused: false,
        elapsed: 0.0,
        smooth_glow: 0.62,
    };
}

fn tick(s: State, dt: f64, _wall_elapsed: f64) -> State {
    let next_elapsed = if s.paused { s.elapsed } else { s.elapsed + dt };
    let next_smooth_glow = smooth_damp(s.smooth_glow, s.glow, dt, 8.0);
    return State {
        elapsed: next_elapsed,
        smooth_glow: next_smooth_glow,
        ..s
    };
}

fn update(s: State, action: str) -> State {
    if action == "preset_sculpt" {
        return State {
            preset_idx: 0,
            twist: 0.35,
            glow: 0.62,
            zoom: 0.45,
            ..s
        };
    }
    if action == "preset_vortex" {
        return State {
            preset_idx: 1,
            twist: 0.92,
            glow: 0.88,
            zoom: 0.68,
            ..s
        };
    }
    if action == "preset_zen" {
        return State {
            preset_idx: 2,
            twist: 0.08,
            glow: 0.38,
            zoom: 0.25,
            ..s
        };
    }
    if action == "toggle_pause" {
        let next_paused = if s.paused { false } else { true };
        return State { paused: next_paused, ..s };
    }
    if action == "reset" {
        return init();
    }
    return s;
}

fn on_slider(s: State, action: str, val: f64) -> State {
    let v = clamp(val, 0.0, 1.0);
    if action == "slider_twist" {
        return State { twist: v, ..s };
    }
    if action == "slider_glow" {
        return State { glow: v, ..s };
    }
    if action == "slider_zoom" {
        return State { zoom: v, ..s };
    }
    return s;
}

// ============================================================================
// 3. INTERACTIVE DECLARATIVE VIEW (Glassmorphism + Live 3D GPU Viewport)
// ============================================================================

fn view(s: &State) -> Widget {
    let twist_pct = to_i64(s.twist * 100.0);
    let glow_pct = to_i64(s.glow * 100.0);
    let zoom_pct = to_i64(s.zoom * 100.0);

    let preset_label = if s.preset_idx == 0 {
        "Liquid Torus"
    } else if s.preset_idx == 1 {
        "Helix Vortex"
    } else {
        "Orbital Zen"
    };

    // Header section with mouse-orbit hint
    let badge = w_badge(
        "badge_raymarch",
        "100% .knr · 3D SDF Raymarching · std/ui + std/math",
        #0f172aee,
        #38bdf8,
    );
    let title = w_text("hero_title", "knr 3D SDF Raymarcher", 30.0, #f8fafc);
    let subtitle = w_text(
        "hero_sub",
        "Move pointer across the viewport to orbit camera  |  Preset: "
            + preset_label
            + "  ·  Twist "
            + to_str(twist_pct)
            + "%  ·  Glow "
            + to_str(glow_pct)
            + "%  ·  Zoom "
            + to_str(zoom_pct)
            + "%",
        14.0,
        #94a3b8,
    );

    let header_items: vec[Widget] = vec_new();
    header_items = vec_push(header_items, badge);
    header_items = vec_push(header_items, title);
    header_items = vec_push(header_items, subtitle);
    let header = w_col("header", style_gap(style_default(), 8.0), header_items);

    // Live 3D SDF GPU Shader Viewport
    let uniforms: vec[f64] = vec_new();
    uniforms = vec_push(uniforms, s.twist);
    uniforms = vec_push(uniforms, s.glow);
    uniforms = vec_push(uniforms, s.zoom);

    let viewport = w_shader(
        "raymarch_viewport",
        "raymarch_scene",
        uniforms,
        Style {
            h: 320.0,
            border: #38bdf866,
            border_w: 1.5,
            r_tl: 16.0,
            r_tr: 16.0,
            r_br: 16.0,
            r_bl: 16.0,
            shadow_x: 0.0,
            shadow_y: 12.0,
            shadow_blur: 32.0,
            shadow_color: #38bdf844,
            ..style_default()
        },
    );

    // Left Control Card: Scene Presets, Mouse Orbit Hint, and Pause Toggle
    let sculpt_bg = if s.preset_idx == 0 {
        "linear(135, #0284c7, #6366f1)"
    } else {
        "#1e293b"
    };
    let vortex_bg = if s.preset_idx == 1 {
        "linear(135, #ec4899, #8b5cf6)"
    } else {
        "#1e293b"
    };
    let zen_bg = if s.preset_idx == 2 {
        "linear(135, #0ea5e9, #14b8a6)"
    } else {
        "#1e293b"
    };

    let preset_row_items: vec[Widget] = vec_new();
    preset_row_items = vec_push(
        preset_row_items,
        w_button(
            "btn_sculpt",
            "Liquid Torus",
            "preset_sculpt",
            style_button(sculpt_bg, #ffffff),
        ),
    );
    preset_row_items = vec_push(
        preset_row_items,
        w_button(
            "btn_vortex",
            "Helix Vortex",
            "preset_vortex",
            style_button(vortex_bg, #ffffff),
        ),
    );
    preset_row_items = vec_push(
        preset_row_items,
        w_button(
            "btn_zen",
            "Orbital Zen",
            "preset_zen",
            style_button(zen_bg, #ffffff),
        ),
    );
    let preset_row = w_row("row_presets", style_gap(style_default(), 10.0), preset_row_items);

    let action_row_items: vec[Widget] = vec_new();
    action_row_items = vec_push(
        action_row_items,
        w_button("btn_reset", "Reset Defaults", "reset", style_button(#334155, #f8fafc)),
    );
    let action_row = w_row("row_actions", style_gap(style_default(), 10.0), action_row_items);

    let orbit_hint = w_text(
        "lbl_orbit_hint",
        "Camera Orbit: Move mouse horizontally/vertically over the 3D shader canvas to rotate yaw & pitch in real time.",
        13.0,
        #94a3b8,
    );
    let pause_toggle = w_toggle(
        "tog_pause",
        "Pause 3D Simulation",
        "toggle_pause",
        s.paused,
        style_default(),
    );

    let left_items: vec[Widget] = vec_new();
    left_items = vec_push(left_items, w_text("lbl_presets", "3D Sculpture Presets", 17.0, #e2e8f0));
    left_items = vec_push(left_items, preset_row);
    left_items = vec_push(left_items, action_row);
    left_items = vec_push(left_items, orbit_hint);
    left_items = vec_push(left_items, pause_toggle);
    let left_card = w_card("card_presets", style_card(), left_items);

    // Right Control Card: 3 Live GPU Uniform Sliders
    let right_items: vec[Widget] = vec_new();
    right_items = vec_push(right_items, w_text("lbl_uniforms", "Live 3D GPU Uniforms", 17.0, #e2e8f0));
    right_items = vec_push(
        right_items,
        w_text("lbl_twist", "Twist (" + to_str(twist_pct) + "%)", 13.0, #94a3b8),
    );
    right_items = vec_push(
        right_items,
        w_slider("sl_twist", "slider_twist", s.twist, style_default()),
    );
    right_items = vec_push(
        right_items,
        w_text("lbl_glow", "Glow (" + to_str(glow_pct) + "%)", 13.0, #94a3b8),
    );
    right_items = vec_push(
        right_items,
        w_slider("sl_glow", "slider_glow", s.glow, style_default()),
    );
    right_items = vec_push(
        right_items,
        w_text("lbl_zoom", "Camera Zoom (" + to_str(zoom_pct) + "%)", 13.0, #94a3b8),
    );
    right_items = vec_push(
        right_items,
        w_slider("sl_zoom", "slider_zoom", s.zoom, style_default()),
    );
    let right_card = w_card("card_sliders", style_card(), right_items);

    // Responsive 2-column Grid
    let grid_items: vec[Widget] = vec_new();
    grid_items = vec_push(grid_items, left_card);
    grid_items = vec_push(grid_items, right_card);
    let controls_grid = w_grid("grid_controls", 2, style_gap(style_default(), 18.0), grid_items);

    // Root vertical layout
    let root_items: vec[Widget] = vec_new();
    root_items = vec_push(root_items, header);
    root_items = vec_push(root_items, viewport);
    root_items = vec_push(root_items, controls_grid);

    return w_col(
        "raymarch_root",
        Style {
            bg: "radial(#172554, #090d16)",
            pad_t: 26.0,
            pad_r: 28.0,
            pad_b: 26.0,
            pad_l: 28.0,
            gap_x: 18.0,
            gap_y: 18.0,
            ..style_default()
        },
        root_items,
    );
}

// ============================================================================
// 4. BUILT-IN DETERMINISTIC UNIT TESTS (`knr test examples/raymarch_3d.knr`)
// ============================================================================

fn test_raymarch_init_tick() -> bool {
    let s0 = init();
    let s1 = tick(s0, 0.016, 0.016);
    let s2 = tick(s1, 0.500, 0.516);
    let s3 = update(s2, "toggle_pause");
    let s4 = tick(s3, 1.000, 1.516);
    let e_cubic = ease_out_cubic(0.5);
    let e_expo = ease_out_expo(0.5);
    return s4.paused
        && s4.elapsed > 0.5
        && s4.elapsed < 0.6
        && e_cubic > 0.8
        && e_expo > 0.9;
}

fn test_raymarch_sdf_cpu_parity() -> bool {
    // Verify std/math helpers + SDF smooth-min blend
    let blend = smin(1.0, 1.0, 0.4);
    let v = Vec3 { x: 3.0, y: 4.0, z: 0.0 };
    let vn = vec3_norm(&v);
    let vlen = vec3_len(&vn);

    // Evaluate full 3D raymarching shader on CPU at center hit and corner background
    let uv_center = Vec2 { x: 0.5, y: 0.5 };
    let mouse_center = Vec2 { x: 0.5, y: 0.5 };
    let c_hit = raymarch_scene(uv_center, 0.8, mouse_center, 0.35, 0.62, 0.45);

    let uv_corner = Vec2 { x: 0.02, y: 0.02 };
    let mouse_orb = Vec2 { x: 0.65, y: 0.45 };
    let c_bg = raymarch_scene(uv_corner, 0.8, mouse_orb, 0.35, 0.62, 0.45);

    let diff_rgb = abs(c_hit.r - c_bg.r) + abs(c_hit.g - c_bg.g) + abs(c_hit.b - c_bg.b);

    return blend < 1.0
        && abs(vlen - 1.0) < 0.001
        && c_hit.a == 1.0
        && c_hit.r >= 0.0
        && c_hit.r <= 1.0
        && c_hit.g >= 0.0
        && c_hit.g <= 1.0
        && c_hit.b >= 0.0
        && c_hit.b <= 1.0
        && c_bg.a == 1.0
        && diff_rgb > 0.05;
}

fn test_raymarch_ui_tree() -> bool {
    let s = init();
    s = update(s, "preset_vortex");
    s = on_slider(s, "slider_twist", 0.82);
    s = on_slider(s, "slider_glow", 0.90);
    s = on_slider(s, "slider_zoom", 0.70);
    s = update(s, "toggle_pause");

    let tree = view(&s);
    let top_children = vec_len(tree.children);

    return s.preset_idx == 1
        && s.paused
        && s.twist > 0.80
        && s.glow > 0.85
        && s.zoom > 0.65
        && tree.kind == "col"
        && tree.key == "raymarch_root"
        && top_children == 3;
}
