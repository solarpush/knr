// Standard typed declarative UI primitives for knr (Native Desktop + Web/WASM).
// Zero raw HTML, zero raw CSS strings — 100% statically verified schemas.

schema UiNode {
    0: kind str,
    1: text str,
    2: action str,
    3: bg str,
    4: color str,
    5: border str,
    6: radius i64,
    7: pad i64,
    8: gap i64,
    9: font_size i64,
    10: children vec[UiNode],
}

fn ui_col(pad: i64, gap: i64, bg: str, children: vec[UiNode]) -> UiNode {
    return UiNode {
        kind: "col",
        text: "",
        action: "",
        bg: bg,
        color: "#f8fafc",
        border: "",
        radius: 0,
        pad: pad,
        gap: gap,
        font_size: 16,
        children: children,
    };
}

fn ui_row(pad: i64, gap: i64, children: vec[UiNode]) -> UiNode {
    return UiNode {
        kind: "row",
        text: "",
        action: "",
        bg: "",
        color: "#f8fafc",
        border: "",
        radius: 0,
        pad: pad,
        gap: gap,
        font_size: 16,
        children: children,
    };
}

fn ui_card(pad: i64, gap: i64, bg: str, border: str, children: vec[UiNode]) -> UiNode {
    return UiNode {
        kind: "card",
        text: "",
        action: "",
        bg: bg,
        color: "#f8fafc",
        border: border,
        radius: 14,
        pad: pad,
        gap: gap,
        font_size: 16,
        children: children,
    };
}

fn ui_text(text: str, font_size: i64, color: str) -> UiNode {
    let empty: vec[UiNode] = vec_new();
    return UiNode {
        kind: "text",
        text: text,
        action: "",
        bg: "",
        color: color,
        border: "",
        radius: 0,
        pad: 0,
        gap: 0,
        font_size: font_size,
        children: empty,
    };
}

fn ui_button(label: str, action: str, bg: str, color: str) -> UiNode {
    let empty: vec[UiNode] = vec_new();
    return UiNode {
        kind: "button",
        text: label,
        action: action,
        bg: bg,
        color: color,
        border: "",
        radius: 10,
        pad: 12,
        gap: 0,
        font_size: 16,
        children: empty,
    };
}

fn ui_badge(label: str, bg: str, color: str) -> UiNode {
    let empty: vec[UiNode] = vec_new();
    return UiNode {
        kind: "badge",
        text: label,
        action: "",
        bg: bg,
        color: color,
        border: "",
        radius: 999,
        pad: 8,
        gap: 0,
        font_size: 13,
        children: empty,
    };
}
