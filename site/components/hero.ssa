    %145 = const_str "+1 (call apply_step %acc 1)"
    %146 = struct_set %144 2 %145
    %147 = const_str "/api/wasm/inc"
    %148 = struct_set %146 3 %147
    %149 = const_str ".wasm-reg-val"
    %150 = struct_set %148 4 %149

    %151 = struct_new Leaf
    %152 = const_str "button"
    %153 = struct_set %151 0 %152
    %154 = const_str "btn btn-sec"
    %155 = struct_set %153 1 %154
    %156 = const_str "Reset (%acc = 0)"
    %157 = struct_set %155 2 %156
    %158 = const_str "/api/wasm/reset"
    %159 = struct_set %157 3 %158
    %160 = const_str ".wasm-reg-val"
    %161 = struct_set %159 4 %160

    %162 = struct_new Leaf
    %163 = const_str "div"
    %164 = struct_set %162 0 %163
    %165 = const_str "demo-sub"
    %166 = struct_set %164 1 %165
