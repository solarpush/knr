    %169 = vec_new struct[Leaf]
    %170 = vec_push %169 %121
    %171 = vec_push %170 %128
    %172 = vec_push %171 %139
    %173 = vec_push %172 %150
    %174 = vec_push %173 %161
    %175 = vec_push %174 %168

