    %115 = struct_new Leaf
    %116 = const_str "div"
    %117 = struct_set %115 0 %116
    %118 = const_str "card-tag"
    %119 = struct_set %117 1 %118
    %120 = const_str "DÉMO INTERACTIVE 2 — SECOND REGISTRE WEBASSEMBLY INDÉPENDANT (%ACC_WASM -> SITE/CLIENT_STATE.SSA)"
