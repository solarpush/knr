    %102 = vec_new struct[Leaf]
    %103 = vec_push %102 %55
    %104 = vec_push %103 %61
    %105 = vec_push %104 %72
    %106 = vec_push %105 %83
    %107 = vec_push %106 %94
    %108 = vec_push %107 %101

    %109 = struct_new Card
    %110 = const_str "div"
    %111 = struct_set %109 0 %110
    %112 = const_str "counter-box"
    %113 = struct_set %111 1 %112
    %114 = struct_set %113 3 %108

