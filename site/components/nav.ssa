 } .btn:active { transform: translateY(0); } .btn-sec { background: #1e293b; color: #e2e8f0; border: 1px solid #334155; } .counter-status { font-family: monospace; font-size: 0.8rem; color: #94a3b8; width: 100%; margin-top: 4px; } .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 56px; } .card { background: linear-gradient(180deg, #0f172a 0%, #0b1120 100%); border: 1px solid #1e293b; border-radius: 12px; padding: 24px; } .card-tag { font-family: monospace; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: #38bdf8; margin-bottom: 8px; } .card-title { font-size: 1.15rem; font-weight: 700; color: #f1f5f9; margin-bottom: 10px; } .card-desc { font-size: 0.92rem; color: #94a3b8; } .code-section { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; margin-bottom: 56px; } .code-card { background: #090e1a; border: 1px solid #1e293b; border-radius: 12px; padding: 22px; } .pre { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.85rem; color: #a5f3fc; white-space: pre-wrap; background: #050811; padding: 16px; border-radius: 8px; border: 1px solid #162032; margin-top: 10px; } .footer-box { grid-column: 1 / -1; border-top: 1px solid #1e293b; padding-top: 28px; margin-top: 16px; } .footer { color: #64748b; font-size: 0.88rem; font-family: monospace; text-align: center; }"
