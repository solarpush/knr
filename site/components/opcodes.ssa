    %206 = struct_set %204 2 %205

    %207 = vec_new struct[Leaf]
    %208 = vec_push %207 %192
    %209 = vec_push %208 %199
    %210 = vec_push %209 %206

    %211 = struct_new Card
    %212 = const_str "article"
