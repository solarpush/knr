    %145 = vec_new struct[Leaf]
    %146 = vec_push %145 %130
    %147 = vec_push %146 %137
    %148 = vec_push %147 %144

    %149 = struct_new Card
    %150 = const_str "article"
    %151 = struct_set %149 0 %150
    %152 = const_str "card"
