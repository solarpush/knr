    %51 = struct_set %49 2 %50

    %52 = vec_new struct[Leaf]
    %53 = vec_push %52 %37
    %54 = vec_push %53 %44
    %55 = vec_push %54 %51

    %56 = struct_new Card
    %57 = const_str "article"
    %58 = struct_set %56 0 %57
    %59 = const_str "card"
    %60 = struct_set %58 1 %59
    %61 = struct_set %60 3 %55

