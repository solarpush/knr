import "../schemas/vdom.ssa.schema"
import "./nav.ssa"
import "./hero.ssa"
import "./exec_graph.ssa"
import "./pillars.ssa"
import "./learn.ssa"
import "./opcodes.ssa"
import "./examples.ssa"

fn render_page(%0: str, %1: str, %2: str) -> str effects(Ui) {
bb0:
    %3 = call build_nav %0
    %4 = vec_new struct[Card]
    %5 = vec_push %4 %3
    %6 = struct_new Section
    %7 = const_str "section"
    %8 = struct_set %6 0 %7
    %9 = struct_set %8 3 %5

    %10 = const_str "État réactif linear SSA • Pont hybride HTTP SSR (site/server.ssa) + Client WASM (site/site.wasm)"
    %11 = call build_hero %1 %10
    %12 = call build_exec_graph
    %13 = call build_pillars
    %14 = call build_learn
    %15 = call build_opcodes
    %16 = call build_examples %2

    %17 = vec_new struct[Section]
    %18 = vec_push %17 %9
    %19 = vec_push %18 %11
    %20 = vec_push %19 %12
    %21 = vec_push %20 %13
    %22 = vec_push %21 %14
    %23 = vec_push %22 %15
    %24 = vec_push %23 %16

    %25 = struct_new Page
    %26 = const_str "main"
    %27 = struct_set %25 0 %26
    %28 = const_str "page"
    %29 = struct_set %27 1 %28
    %30 = struct_set %29 3 %24

    %31 = syscall Ui "ui.render" %30
    ret %31
}
