import "../schemas/vdom.ssa.schema"
import "./nav.ssa"
import "./hero.ssa"
import "./pillars.ssa"
import "./learn.ssa"
import "./opcodes.ssa"
import "./examples.ssa"

fn render_page(%0: str, %1: str, %2: str) -> str effects(Ui) {
bb0:
    %3 = call build_nav %0
    %4 = vec_new struct[Card]
    %5 = vec_push %4 %3
    %6 = struct_new Section
    %7 = const_str "section"
    %8 = struct_set %6 0 %7
    %9 = struct_set %8 3 %5

    %10 = const_str "État réactif linear SSA • Pont hybride HTTP SSR (site/server.ssa) + Client WASM (site/site.wasm)"
    %11 = call build_hero %1 %10
    %12 = call build_pillars
    %13 = call build_learn
    %14 = call build_opcodes
    %15 = call build_examples %2

    %16 = vec_new struct[Section]
    %17 = vec_push %16 %9
    %18 = vec_push %17 %11
    %19 = vec_push %18 %12
    %20 = vec_push %19 %13
    %21 = vec_push %20 %14
    %22 = vec_push %21 %15

    %23 = struct_new Page
    %24 = const_str "main"
    %25 = struct_set %23 0 %24
    %26 = const_str "page"
    %27 = struct_set %25 1 %26
    %28 = struct_set %27 3 %22

    %29 = syscall Ui "ui.render" %28
    ret %29
}
