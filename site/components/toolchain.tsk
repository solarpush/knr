// ============================================================================
// knr Official Showcase -- Code Gallery & Toolchain (`site/components/toolchain.tsk`)
// ============================================================================

import {
    Column,
    Row,
    Grid,
    Card,
    Badge,
    Text,
    Code,
    Button,
    Icon,
    Divider,
} from "std/ui";
import { State } from "../state.tsk";

export function sample_filename(idx: i64): string {
    if (idx === 1) {
        return "examples/raymarch_3d.tsk";
    }
    if (idx === 2) {
        return "examples/http_server.tsk";
    }
    if (idx === 3) {
        return "examples/sys_demo.tsk";
    }
    return "examples/counter_app.tsk";
}

export function sample_command(idx: i64): string {
    if (idx === 1) {
        return "knr run examples/raymarch_3d.tsk --gui";
    }
    if (idx === 2) {
        return "knr build examples/http_server.tsk --target native -o ./http_server";
    }
    if (idx === 3) {
        return "knr run examples/sys_demo.tsk";
    }
    return "knr render examples/counter_app.tsk -o /tmp/counter.png --audit";
}

export function sample_code(idx: i64): string {
    if (idx === 1) {
        return "import { Vec2, Color } from \"std/ui\";\n"
            + "import { Vec3, smin, vec3_dot } from \"std/math\";\n\n"
            + "@shader\n"
            + "export function raymarch(uv: Vec2, time: f64, mouse: Vec2): Color {\n"
            + "    const d = smin(sd_torus(p, 0.88, 0.26), sd_sphere(p, 0.34), 0.42);\n"
            + "    const shade = max(vec3_dot(n, light), 0.0);\n"
            + "    return { r: shade * 0.35, g: shade * 0.78, b: 0.98, a: 1.0 };\n"
            + "}";
    }
    if (idx === 2) {
        return "import { HttpRequest, HttpResponse, classify_route } from \"./http_types.tsk\";\n\n"
            + "@effects(\"net\")\n"
            + "export function main(): i64 {\n"
            + "    const srv: i64 = syscall(\"net\", \"net.listen\", 8080);\n"
            + "    const req: HttpRequest = syscall(\"net\", \"net.wait_req\", srv);\n"
            + "    const resp: HttpResponse = { req_id: req.req_id, status: 200, body: \"ok\" };\n"
            + "    const _ok: bool = syscall(\"net\", \"net.respond\", resp);\n"
            + "    return 0;\n"
            + "}";
    }
    if (idx === 3) {
        return "import { fs_write, fs_read, json_get } from \"std/sys\";\n\n"
            + "@effects(\"hw\")\n"
            + "export function main(): i64 {\n"
            + "    const ok = fs_write(\"config.json\", \"{\\\"lang\\\":\\\"knr\\\"}\");\n"
            + "    const raw = fs_read(\"config.json\");\n"
            + "    const name = json_get(raw, \"lang\");\n"
            + "    return ok && name === \"knr\" ? 0 : 1;\n"
            + "}";
    }
    return "import { Column, Button, Text } from \"std/ui\";\n\n"
        + "export type State = { count: i64 };\n\n"
        + "export function update(s: State, act: string): State {\n"
        + "    return act === \"inc\" ? { ...s, count: s.count + 1 } : s;\n"
        + "}\n\n"
        + "export function view(s: readonly State): Widget {\n"
        + "    return (\n"
        + "        <Column p={24} gap={12}>\n"
        + "            <Text size={28} weight=\"bold\">{`Count: ${s.count}`}</Text>\n"
        + "            <Button onClick=\"inc\">Increase</Button>\n"
        + "        </Column>\n"
        + "    );\n"
        + "}";
}

export function Toolchain(s: readonly State): Widget {
    return (
        <Column key="tab_view_toolchain" w="full" gap={22}>
            <Column gap={8} pt={4}>
                <Row align="center" gap={8}>
                    <Icon name="terminal" size={15} color="#38bdf8" />
                    <Text size={13} weight="semibold" color="#38bdf8">
                        SINGLE-BINARY TOOLCHAIN
                    </Text>
                    <Text size={13} color="#64748b">
                        Human & AI Agent Workflow
                    </Text>
                </Row>
                <Text
                    size={32}
