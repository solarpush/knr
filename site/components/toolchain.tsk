                </Card>

                <Card bg="#0b0f1c" border="#ffffff14" hoverBorder="#38bdf866" radius={16} p={20} gap={10}>
                    <Row align="center" gap={8}>
                        <Icon name="rocket" size={15} color="#818cf8" />
