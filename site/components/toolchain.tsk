                            MVU App
                        </Text>
                    </Button>
                    <Button
                        key="code_tab_shader"
                        onClick="code_shader"
                        bg={s.code_sample === 1 ? "#1a1936" : "#0e1322"}
                        border={s.code_sample === 1 ? "#818cf866" : "#ffffff14"}
                        hoverBorder="#818cf855"
                        px={13}
                        py={8}
                        radius={9}
                        gap={7}
                        align="center"
                    >
                        <Icon name="cube" size={14} color={s.code_sample === 1 ? "#818cf8" : "#64748b"} />
                        <Text size={13} weight="semibold" color={s.code_sample === 1 ? "#f8fafc" : "#94a3b8"}>
                            3D Shader
                        </Text>
                    </Button>
                    <Button
