import "schemas/http.ssa.schema"
import "components/page.ssa"

fn main() -> i64 effects(Ui, Net, Async) {
bb0:
    %0 = const_i64 8080
    %1 = syscall Net "net.listen" %0
    %2 = const_i64 1
    %3 = chan_new i64 %2
    %4 = const_i64 0
    %5 = chan_send %3 %4
    %6 = chan_new i64 %2
    %7 = const_i64 42
    %8 = chan_send %6 %7
    %9 = const_i64 200
    %10 = const_str "/api/inc"
    %11 = const_str "/api/dec"
    %12 = const_str "/api/reset"
    br bb1

bb1:
    %13 = syscall Net "net.wait_req" %1
    %14 = struct_get %13 0
    %15 = struct_get %13 2
    free %13
    %16 = cmp_eq %15 %10
    br_if %16 bb2 bb3

bb2:
    %17 = chan_recv %3
    %18 = add %17 %2
    %19 = chan_send %3 %18
    %20 = struct_new HttpResponseInt
    %21 = struct_set %20 0 %14
    %22 = struct_set %21 1 %9
    %23 = struct_set %22 2 %18
    %24 = syscall Net "net.respond" %23
    br bb1

bb3:
    %25 = cmp_eq %15 %11
    br_if %25 bb4 bb5

bb4:
    %26 = chan_recv %3
    %27 = sub %26 %2
    %28 = chan_send %3 %27
    %29 = struct_new HttpResponseInt
    %30 = struct_set %29 0 %14
    %31 = struct_set %30 1 %9
    %32 = struct_set %31 2 %27
    %33 = syscall Net "net.respond" %32
    br bb1

bb5:
    %34 = cmp_eq %15 %12
    br_if %34 bb6 bb7

bb6:
    %35 = chan_recv %3
    %36 = chan_send %3 %4
    %37 = struct_new HttpResponseInt
    %38 = struct_set %37 0 %14
    %39 = struct_set %38 1 %9
    %40 = struct_set %39 2 %4
    %41 = syscall Net "net.respond" %40
    br bb1

bb7:
    %42 = const_str "/api/wasm/inc"
    %43 = cmp_eq %15 %42
    br_if %43 bb8 bb9

bb8:
    %44 = chan_recv %6
    %45 = add %44 %2
    %46 = chan_send %6 %45
    %47 = call reply_int %14 %9 %45
    br bb1

bb9:
    %48 = const_str "/api/wasm/dec"
    %49 = cmp_eq %15 %48
    br_if %49 bb10 bb11

bb10:
    %50 = chan_recv %6
    %51 = sub %50 %2
    %52 = chan_send %6 %51
    %53 = call reply_int %14 %9 %51
    br bb1

bb11:
    %54 = const_str "/api/wasm/reset"
    %55 = cmp_eq %15 %54
    br_if %55 bb12 bb13

bb12:
    %56 = chan_recv %6
    %57 = chan_send %6 %4
    %58 = call reply_int %14 %9 %4
    br bb1

bb13:
    %59 = const_str "/nav/home"
    %60 = cmp_eq %15 %59
    br_if %60 bb14 bb15

bb14:
    %61 = const_str ".page-graph, .page-pillars, .page-learn, .page-isa, .page-examples { display: none !important; } .tab-home { background: #38bdf8 !important; color: #050811 !important; border-color: #38bdf8 !important; }"
    %62 = call reply_text %14 %9 %61
    br bb1

bb15:
    %63 = const_str "/nav/graph"
    %64 = cmp_eq %15 %63
    br_if %64 bb16 bb17

bb16:
    %65 = const_str ".page-home, .page-pillars, .page-learn, .page-isa, .page-examples { display: none !important; } .tab-graph { background: #38bdf8 !important; color: #050811 !important; border-color: #38bdf8 !important; }"
    %66 = call reply_text %14 %9 %65
    br bb1

bb17:
    %67 = const_str "/nav/pillars"
    %68 = cmp_eq %15 %67
    br_if %68 bb18 bb19

bb18:
    %69 = const_str ".page-home, .page-graph, .page-learn, .page-isa, .page-examples { display: none !important; } .tab-pillars { background: #38bdf8 !important; color: #050811 !important; border-color: #38bdf8 !important; }"
    %70 = call reply_text %14 %9 %69
    br bb1

bb19:
    %71 = const_str "/nav/learn"
    %72 = cmp_eq %15 %71
    br_if %72 bb20 bb21

bb20:
    %73 = const_str ".page-home, .page-graph, .page-pillars, .page-isa, .page-examples { display: none !important; } .tab-learn { background: #38bdf8 !important; color: #050811 !important; border-color: #38bdf8 !important; }"
    %74 = call reply_text %14 %9 %73
    br bb1

bb21:
    %75 = const_str "/nav/isa"
    %76 = cmp_eq %15 %75
    br_if %76 bb22 bb23

bb22:
    %77 = const_str ".page-home, .page-graph, .page-pillars, .page-learn, .page-examples { display: none !important; } .tab-isa { background: #38bdf8 !important; color: #050811 !important; border-color: #38bdf8 !important; }"
    %78 = call reply_text %14 %9 %77
    br bb1

bb23:
    %79 = const_str "/nav/examples"
    %80 = cmp_eq %15 %79
    br_if %80 bb24 bb25

bb24:
    %81 = const_str ".page-home, .page-graph, .page-pillars, .page-learn, .page-isa { display: none !important; } .tab-examples { background: #38bdf8 !important; color: #050811 !important; border-color: #38bdf8 !important; }"
    %82 = call reply_text %14 %9 %81
    br bb1

bb25:
    %83 = const_str "/nav/all"
    %84 = cmp_eq %15 %83
    br_if %84 bb26 bb27

bb26:
    %85 = const_str ".tab-all { background: #38bdf8 !important; color: #050811 !important; border-color: #38bdf8 !important; }"
    %86 = call reply_text %14 %9 %85
    br bb1

bb27:
    %87 = const_str "/trace/inc"
    %88 = cmp_eq %15 %87
    br_if %88 bb28 bb29

bb28:
    %89 = const_str ".node-ast, .node-verify, .node-bb0, .node-bb2, .node-call { border-color: #38bdf8 !important; box-shadow: 0 0 28px rgba(56, 189, 248, 0.35) !important; transform: translateY(-3px); } .node-bb1, .node-ssr { opacity: 0.35; } .trace-inc { box-shadow: 0 0 18px rgba(56, 189, 248, 0.65) !important; }"
    %90 = call reply_text %14 %9 %89
    br bb1

bb29:
    %91 = const_str "/trace/dec"
    %92 = cmp_eq %15 %91
    br_if %92 bb30 bb31

bb30:
    %93 = const_str ".node-ast, .node-verify, .node-bb0, .node-bb2, .node-call { border-color: #a855f7 !important; box-shadow: 0 0 28px rgba(168, 85, 247, 0.35) !important; transform: translateY(-3px); } .node-bb1, .node-ssr { opacity: 0.35; } .trace-dec { border-color: #a855f7 !important; color: #e9d5ff !important; box-shadow: 0 0 18px rgba(168, 85, 247, 0.55) !important; }"
    %94 = call reply_text %14 %9 %93
    br bb1

bb31:
    %95 = const_str "/trace/reset"
    %96 = cmp_eq %15 %95
    br_if %96 bb32 bb33

bb32:
    %97 = const_str ".node-ast, .node-verify, .node-bb0, .node-bb1 { border-color: #f59e0b !important; box-shadow: 0 0 28px rgba(245, 158, 11, 0.35) !important; transform: translateY(-3px); } .node-bb2, .node-call, .node-ssr { opacity: 0.35; } .trace-reset { border-color: #f59e0b !important; color: #fde68a !important; box-shadow: 0 0 18px rgba(245, 158, 11, 0.55) !important; }"
    %98 = call reply_text %14 %9 %97
    br bb1

bb33:
    %99 = const_str "/trace/ssr"
    %100 = cmp_eq %15 %99
    br_if %100 bb34 bb35

bb34:
    %101 = const_str ".node-ast, .node-verify, .node-ssr { border-color: #10b981 !important; box-shadow: 0 0 28px rgba(16, 185, 129, 0.38) !important; transform: translateY(-3px); } .node-bb0, .node-bb1, .node-bb2, .node-call { opacity: 0.35; } .trace-ssr { box-shadow: 0 0 18px rgba(16, 185, 129, 0.65) !important; }"
    %102 = call reply_text %14 %9 %101
    br bb1

bb35:
    %103 = chan_recv %3
    %104 = chan_send %3 %103
    %105 = syscall Ui "ui.render" %103
    %106 = const_str "LIVE SSR • 100% Pure knr (.ssa)"
    %107 = const_str "Servi en direct en SSR par knr (site/server.ssa) via UiPlatform + NetPlatform (Tokio)."
    %108 = call render_page %106 %105 %107
    %109 = call reply_text %14 %9 %108
    br bb1
}

fn reply_int(%0: i64, %1: i64, %2: i64) -> bool effects(Net) {
bb0:
    %3 = struct_new HttpResponseInt
    %4 = struct_set %3 0 %0
    %5 = struct_set %4 1 %1
    %6 = struct_set %5 2 %2
    %7 = syscall Net "net.respond" %6
    ret %7
}

fn reply_text(%0: i64, %1: i64, %2: str) -> bool effects(Net) {
bb0:
    %3 = struct_new HttpResponse
    %4 = struct_set %3 0 %0
    %5 = struct_set %4 1 %1
    %6 = struct_set %5 2 %2
    %7 = syscall Net "net.respond" %6
    ret %7
}
