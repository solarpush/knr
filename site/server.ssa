    // 1. Boucle d'événements HTTP : attente d'une requête et lecture du Counter
    // =========================================================================
    %10 = syscall Net "net.wait_req" %1
    %11 = struct_get %10 0
    %12 = struct_get %10 2
    free %10
    %13 = chan_recv %3
    %14 = cmp_eq %12 %7
    br_if %14 bb2 bb3

bb2:
    // Route POST /api/inc : incrémente %13 et répond avec la nouvelle valeur
    %15 = add %13 %2
    %16 = chan_send %3 %15
    %17 = struct_new HttpResponseInt
    %18 = struct_set %17 0 %11
    %19 = struct_set %18 1 %6
    %20 = struct_set %19 2 %15
    %21 = syscall Net "net.respond" %20
    br bb1

bb3:
