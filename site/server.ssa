import "schemas/http.ssa.schema"
import "components/page.ssa"

fn main() -> i64 effects(Ui, Net, Async) {
bb0:
    %0 = const_i64 8080
    %1 = syscall Net "net.listen" %0
    %2 = const_i64 1
    %3 = chan_new i64 %2
    %4 = const_i64 0
    %5 = chan_send %3 %4
    %6 = const_i64 200
    %7 = const_str "/api/inc"
    %8 = const_str "/api/dec"
    %9 = const_str "/api/reset"
    br bb1

bb1:
    %10 = syscall Net "net.wait_req" %1
    %11 = struct_get %10 0
    %12 = struct_get %10 2
    free %10
    %13 = chan_recv %3
    %14 = cmp_eq %12 %7
    br_if %14 bb2 bb3

bb2:
    %15 = add %13 %2
    %16 = chan_send %3 %15
    %17 = struct_new HttpResponseInt
    %18 = struct_set %17 0 %11
    %19 = struct_set %18 1 %6
    %20 = struct_set %19 2 %15
    %21 = syscall Net "net.respond" %20
    br bb1

bb3:
    %22 = cmp_eq %12 %8
    br_if %22 bb4 bb5

bb4:
    %23 = sub %13 %2
    %24 = chan_send %3 %23
    %25 = struct_new HttpResponseInt
    %26 = struct_set %25 0 %11
    %27 = struct_set %26 1 %6
    %28 = struct_set %27 2 %23
    %29 = syscall Net "net.respond" %28
    br bb1

bb5:
    %30 = cmp_eq %12 %9
    br_if %30 bb6 bb7

bb6:
    %31 = chan_send %3 %4
    %32 = struct_new HttpResponseInt
    %33 = struct_set %32 0 %11
    %34 = struct_set %33 1 %6
    %35 = struct_set %34 2 %4
    %36 = syscall Net "net.respond" %35
    br bb1

bb7:
    %37 = chan_send %3 %13
    %38 = syscall Ui "ui.render" %13
    %39 = const_str "LIVE SSR • 100% Pure knr (.ssa)"
    %40 = const_str "Servi en direct en SSR par knr (site/server.ssa) via UiPlatform + NetPlatform (Tokio)."
    %41 = call render_page %39 %38 %40
    %42 = struct_new HttpResponse
    %43 = struct_set %42 0 %11
    %44 = struct_set %43 1 %6
    %45 = struct_set %44 2 %41
    %46 = syscall Net "net.respond" %45
    br bb1
}
