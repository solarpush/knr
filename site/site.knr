}

fn w_bold_text(key: str, text: str, font_size: f64, weight: i64, color: str) -> Widget {
    let empty_u: vec[f64] = vec_new();
    let empty_c: vec[Widget] = vec_new();
    return Widget {
        key: key,
        kind: "text",
        text: text,
        action: "",
        value: 0.0,
        uniforms: empty_u,
        style: Style {
            color: color,
            font_size: font_size,
            font_weight: weight,
            ..style_default()
        },
        children: empty_c,
    };
}

fn w_info_card(
    key: str,
    badge_label: str,
    badge_bg: str,
    badge_fg: str,
    title: str,
    body: str,
    foot: str,
) -> Widget {
    let k_badge = key + "_b";
    let k_title = key + "_t";
    let k_body = key + "_d";
    let k_foot = key + "_f";

    let items: vec[Widget] = vec_new();
    items = vec_push(items, w_badge(k_badge, badge_label, badge_bg, badge_fg));
    items = vec_push(items, w_bold_text(k_title, title, 18.0, 700, #f8fafc));
    items = vec_push(items, w_text(k_body, body, 14.0, #94a3b8));
    items = vec_push(items, w_bold_text(k_foot, foot, 13.0, 600, #38bdf8));
    return w_card(key, style_glass(), items);
}

fn w_stat_card(key: str, metric: str, label: str, accent: str) -> Widget {
    let k_val = key + "_v";
    let k_lbl = key + "_l";

    let items: vec[Widget] = vec_new();
    items = vec_push(items, w_bold_text(k_val, metric, 26.0, 800, accent));
    items = vec_push(items, w_text(k_lbl, label, 13.0, #94a3b8));
    return w_card(
        key,
        Style {
            bg: #0f172acc,
            border: #33415588,
            r_tl: 16.0,
            r_tr: 16.0,
            r_br: 16.0,
            r_bl: 16.0,
            pad_t: 18.0,
            pad_r: 20.0,
            pad_b: 18.0,
            pad_l: 20.0,
            gap_y: 6.0,
            backdrop_blur: 18.0,
            hover_border: #38bdf866,
            transition_ms: 160.0,
            ..style_card()
        },
        items,
    );
}

fn make_shader_uniforms(s: &State) -> vec[f64] {
    let u: vec[f64] = vec_new();
    u = vec_push(u, s.energy);
    u = vec_push(u, s.hue_shift);
    return u;
}

fn style_nebula_viewport(height_px: f64) -> Style {
    return Style {
        h: height_px,
        border: #38bdf877,
        border_w: 1.5,
        r_tl: 18.0,
        r_tr: 18.0,
        r_br: 18.0,
        r_bl: 18.0,
        shadow_x: 0.0,
        shadow_y: 12.0,
        shadow_blur: 36.0,
        shadow_color: #38bdf833,
        ..style_default()
    };
}

// ============================================================================
// 4. TOP NAVIGATION BAR & FOOTER
// ============================================================================

fn view_navbar(s: &State) -> Widget {
    let brand_items: vec[Widget] = vec_new();
    brand_items = vec_push(brand_items, w_bold_text("brand_logo", "knr", 24.0, 800, #f8fafc));
    brand_items = vec_push(brand_items, w_badge("brand_ver", "v1.0 · Pure .knr", #0f172aee, #38bdf8));
    let brand_row = w_row("nav_brand", style_gap(style_default(), 12.0), brand_items);

    let nav_items: vec[Widget] = vec_new();
    nav_items = vec_push(
        nav_items,
        w_button("nav_overview", "Overview", "tab_overview", style_nav_btn(s.active_tab == 0)),
    );
    nav_items = vec_push(
        nav_items,
        w_button("nav_shaders", "GPU & Shaders", "tab_shaders", style_nav_btn(s.active_tab == 1)),
    );
    nav_items = vec_push(
        nav_items,
        w_button("nav_safety", "Linear Safety", "tab_safety", style_nav_btn(s.active_tab == 2)),
    );
    nav_items = vec_push(
        nav_items,
        w_button("nav_toolchain", "Toolchain", "tab_toolchain", style_nav_btn(s.active_tab == 3)),
    );
    let nav_tabs = w_row("nav_tabs", style_gap(style_default(), 10.0), nav_items);

    let bar_items: vec[Widget] = vec_new();
    bar_items = vec_push(bar_items, brand_row);
    bar_items = vec_push(bar_items, nav_tabs);

    return w_row(
        "top_navbar",
        Style {
            bg: #0b1224cc,
            border: #334155aa,
            border_w: 1.0,
            r_tl: 18.0,
            r_tr: 18.0,
            r_br: 18.0,
            r_bl: 18.0,
            pad_t: 14.0,
            pad_r: 20.0,
            pad_b: 14.0,
            pad_l: 20.0,
            gap_x: 16.0,
            gap_y: 12.0,
            align: "center",
            justify: "between",
            shadow_x: 0.0,
            shadow_y: 10.0,
            shadow_blur: 28.0,
            shadow_color: #00000066,
            backdrop_blur: 18.0,
            transition_ms: 160.0,
            ..style_default()
        },
        bar_items,
    );
}

fn view_footer(s: &State) -> Widget {
    let tab_name = if s.active_tab == 0 {
        "Overview"
    } else if s.active_tab == 1 {
        "GPU & Shaders"
    } else if s.active_tab == 2 {
        "Linear Safety"
    } else {
        "Toolchain"
    };
    let secs = to_i64(s.elapsed);

    let foot_items: vec[Widget] = vec_new();
    foot_items = vec_push(
        foot_items,
        w_text(
            "foot_left",
            "Built 100% in knr (site/site.knr) · Zero HTML · Zero CSS · Zero GLSL · Verified Linear SSA",
            13.0,
            #94a3b8,
        ),
    );
    foot_items = vec_push(
        foot_items,
        w_text(
            "foot_right",
            "Section: " + tab_name + "  ·  Preset: " + s.preset_name + "  ·  Uptime " + to_str(secs) + "s",
            13.0,
            #64748b,
        ),
    );

    return w_row(
        "site_footer",
        Style {
            bg: #0b1224aa,
            border: #1e293baa,
            border_w: 1.0,
            r_tl: 16.0,
            r_tr: 16.0,
            r_br: 16.0,
            r_bl: 16.0,
            pad_t: 14.0,
            pad_r: 20.0,
            pad_b: 14.0,
            pad_l: 20.0,
            gap_x: 16.0,
            gap_y: 8.0,
            justify: "between",
            align: "center",
            backdrop_blur: 18.0,
            ..style_default()
        },
        foot_items,
    );
}

// ============================================================================
// 5. TAB 0 — OVERVIEW (Hero Nebula Canvas + 3-Column Feature Cards + Stats)
// ============================================================================

fn view_tab_overview(s: &State) -> Widget {
    let energy_pct = to_i64(s.energy * 100.0);
    let hue_pct = to_i64(s.hue_shift * 100.0);

    let cta_items: vec[Widget] = vec_new();
    cta_items = vec_push(
        cta_items,
        w_button("cta_lab", "Open GPU Shader Lab", "tab_shaders", style_cta_primary()),
    );
    cta_items = vec_push(
        cta_items,
        w_button("cta_safety", "Inspect Linear Safety", "tab_safety", style_cta_secondary()),
    );
    cta_items = vec_push(
        cta_items,
        w_button("cta_tools", "Explore Toolchain", "tab_toolchain", style_cta_secondary()),
    );
    let cta_row = w_row("hero_ctas", style_gap(style_default(), 12.0), cta_items);

    let hero_shader = w_shader(
        "hero_nebula_overview",
        "knr_hero_nebula",
        make_shader_uniforms(&s),
        style_nebula_viewport(310.0),
    );

    let hero_items: vec[Widget] = vec_new();
    hero_items = vec_push(
        hero_items,
        w_badge(
            "hero_badge",
            "100% Pure .knr · wgpu + WebGPU/WebGL2 · Zero HTML / Zero CSS / Zero GLSL",
            #0f172aee,
            #38bdf8,
        ),
    );
    hero_items = vec_push(hero_items, w_bold_text("hero_title", s.headline, 34.0, 800, #f8fafc));
    hero_items = vec_push(
        hero_items,
        w_text(
            "hero_desc",
            "One statically verified linear programming language compiling to deterministic VM, native Cranelift ELF binaries, zero-import WebAssembly, and real-time GPU shaders — with zero garbage collector and zero lifetime annotations.",
            16.0,
            #cbd5e1,
        ),
    );
    hero_items = vec_push(hero_items, cta_row);
    hero_items = vec_push(hero_items, hero_shader);
    hero_items = vec_push(
        hero_items,
        w_text(
            "hero_telemetry",
            "Live GPU Kernel: knr_hero_nebula (WGSL + GLSL ES 3.00)  ·  Preset: " + s.preset_name + "  ·  Energy " + to_str(energy_pct) + "%  ·  Hue " + to_str(hue_pct) + "%  ·  Move pointer across canvas to energize core",
            13.0,
            #94a3b8,
        ),
    );
    let hero_card = w_card("overview_hero", style_hero_glass(), hero_items);

    // 3-Column Feature Pillars
    let pillar_items: vec[Widget] = vec_new();
    pillar_items = vec_push(
        pillar_items,
        w_info_card(
            "pillar_linear",
            "ZERO GC",
            #0c4a6eaa,
            #38bdf8,
            "Zero-GC Linear Ownership",
            "Every struct, enum, vec, map, buffer, and channel has unique linear ownership with deterministic scope auto-drop and second-class &T borrows — eliminating leaks and use-after-move at compile time.",
            "Second-class &T · Zero lifetime annotations",
        ),
    );
    pillar_items = vec_push(
        pillar_items,
        w_info_card(
            "pillar_parity",
            "TRIPLE PARITY",
            #312e81aa,
            #a5b4fc,
            "Triple-Parity VM / Cranelift / WASM",
            "Canonical linear SSA lowers bit-identically to the deterministic reference VM, native Cranelift machine code linked with knr-runtime, and zero-import WebAssembly + SSR web bundles.",
            "VM == Native ELF == WebAssembly",
        ),
    );
    pillar_items = vec_push(
        pillar_items,
        w_info_card(
            "pillar_gpu",
            "WGSL + GLSL",
            #4c1d95aa,
            #c4b5fd,
            "Native GPU & Shaders",
            "Write pure GPU kernels directly in .knr with shader fn. Verified free of effects, heap ops, and recursion, then compiled via naga to native wgpu Vulkan/Metal/DX12 and browser WebGPU/WebGL2.",
            "60/120 FPS SDF UI + Dual Kawase Blur",
        ),
    );
    let pillars_grid = w_grid("overview_pillars", 3, style_gap(style_default(), 18.0), pillar_items);

    // 4-Column Architecture Metrics Strip
    let stat_items: vec[Widget] = vec_new();
    stat_items = vec_push(stat_items, w_stat_card("stat_verify", "< 100 us", "Static SSA & Linear Verification", #38bdf8));
    stat_items = vec_push(stat_items, w_stat_card("stat_gc", "0 ms", "GC Pauses & Heap Leaks", #34d399));
    stat_items = vec_push(stat_items, w_stat_card("stat_bijection", "1 : 1", "Lossless .ssa <-> .knrbin Codec", #a78bfa));
    stat_items = vec_push(stat_items, w_stat_card("stat_fps", "120 FPS", "Native wgpu & WebGPU Pipeline", #f472b6));
    let stats_grid = w_grid("overview_stats", 4, style_gap(style_default(), 14.0), stat_items);

    let tab_items: vec[Widget] = vec_new();
    tab_items = vec_push(tab_items, hero_card);
    tab_items = vec_push(tab_items, pillars_grid);
    tab_items = vec_push(tab_items, stats_grid);
    return w_col("tab_view_overview", style_gap(style_default(), 20.0), tab_items);
}

// ============================================================================
// 6. TAB 1 — GPU & SHADERS (Live Controls, Presets & Headline Customizer)
// ============================================================================

fn view_tab_shaders(s: &State) -> Widget {
    let energy_pct = to_i64(s.energy * 100.0);
    let hue_pct = to_i64(s.hue_shift * 100.0);
    let clock_txt = if s.paused { "Frozen" } else { "60/120 FPS Live" };

    // Top studio header + live GPU canvas
    let lab_shader = w_shader(
        "lab_nebula_canvas",
        "knr_hero_nebula",
        make_shader_uniforms(&s),
        style_nebula_viewport(320.0),
    );

    let head_items: vec[Widget] = vec_new();
    head_items = vec_push(
        head_items,
        w_badge(
            "lab_badge",
            "LIVE GPU SHADER WORKBENCH · naga WGSL + WebGL2 GLSL ES 3.00",
            #0f172aee,
            #c084fc,
        ),
    );
    head_items = vec_push(head_items, w_bold_text("lab_title", s.headline, 28.0, 800, #f8fafc));
    head_items = vec_push(
        head_items,
        w_text(
            "lab_sub",
            "Preset: " + s.preset_name + "  ·  Energy " + to_str(energy_pct) + "%  ·  Hue Shift " + to_str(hue_pct) + "%  ·  Clock: " + clock_txt,
            14.0,
            #94a3b8,
        ),
    );
    head_items = vec_push(head_items, lab_shader);
    let lab_card = w_card("lab_stage_card", style_hero_glass(), head_items);

    // Left Control Card: Live GPU Uniform Sliders + Clock Freeze Toggle
    let toggle_bg = if s.paused { #1e3a8acc } else { #0f172acc };
    let toggle_bdr = if s.paused { #38bdf8aa } else { #334155aa };
    let toggle_style = Style {
        bg: toggle_bg,
        color: #e2e8f0,
        border: toggle_bdr,
        border_w: 1.0,
        r_tl: 12.0,
        r_tr: 12.0,
        r_br: 12.0,
        r_bl: 12.0,
        pad_t: 10.0,
        pad_r: 16.0,
        pad_b: 10.0,
        pad_l: 16.0,
        font_size: 14.0,
        font_weight: 600,
        transition_ms: 160.0,
        ..style_default()
    };

    let left_actions: vec[Widget] = vec_new();
    left_actions = vec_push(
        left_actions,
        w_toggle("tog_pause", "Freeze Simulation Clock", "toggle_pause", s.paused, toggle_style),
    );
    left_actions = vec_push(
        left_actions,
        w_button("btn_reset", "Reset Defaults", "reset_defaults", style_cta_secondary()),
    );
    let left_action_row = w_row("lab_clock_row", style_gap(style_default(), 10.0), left_actions);

    let left_items: vec[Widget] = vec_new();
    left_items = vec_push(left_items, w_bold_text("lbl_uniforms", "Live GPU Uniforms", 18.0, 700, #f8fafc));
    left_items = vec_push(
        left_items,
        w_text("lbl_energy", "Nebula Energy — uniforms[0] (" + to_str(energy_pct) + "%)", 13.0, #cbd5e1),
    );
    left_items = vec_push(left_items, w_slider("sl_energy", "slider_energy", s.energy, style_default()));
    left_items = vec_push(
        left_items,
        w_text("lbl_hue", "Spectral Hue Shift — uniforms[1] (" + to_str(hue_pct) + "%)", 13.0, #cbd5e1),
    );
    left_items = vec_push(left_items, w_slider("sl_hue", "slider_hue", s.hue_shift, style_default()));
    left_items = vec_push(left_items, left_action_row);
    let left_card = w_card("lab_uniform_card", style_glass(), left_items);

    // Right Control Card: Shader Presets + Live Headline TextInput
    let preset_items: vec[Widget] = vec_new();
    preset_items = vec_push(
        preset_items,
        w_button(
            "btn_cyber_cyan",
            "Cyber Cyan",
            "preset_cyber_cyan",
            style_preset_btn(s.preset_name == "Cyber Cyan", "linear(135, #0284c7, #6366f1)", #ffffff),
        ),
    );
    preset_items = vec_push(
        preset_items,
        w_button(
            "btn_solar_violet",
            "Solar Violet",
            "preset_solar_violet",
            style_preset_btn(s.preset_name == "Solar Violet", "linear(135, #ec4899, #7c3aed)", #ffffff),
        ),
    );
    preset_items = vec_push(
        preset_items,
        w_button(
            "btn_deep_ocean",
            "Deep Ocean",
            "preset_deep_ocean",
            style_preset_btn(s.preset_name == "Deep Ocean", "linear(135, #0ea5e9, #14b8a6)", #04101c),
        ),
    );
    let preset_row = w_row("lab_preset_row", style_gap(style_default(), 10.0), preset_items);

    let input_style = Style {
        bg: #090f1fee,
        color: #f8fafc,
        border: #38bdf866,
        border_w: 1.0,
        r_tl: 12.0,
        r_tr: 12.0,
        r_br: 12.0,
        r_bl: 12.0,
        pad_t: 11.0,
        pad_r: 14.0,
        pad_b: 11.0,
        pad_l: 14.0,
        font_size: 14.0,
        transition_ms: 160.0,
        ..style_default()
    };

    let right_items: vec[Widget] = vec_new();
    right_items = vec_push(right_items, w_bold_text("lbl_presets", "Shader Presets & Live Headline", 18.0, 700, #f8fafc));
    right_items = vec_push(right_items, preset_row);
    right_items = vec_push(
        right_items,
        w_text("lbl_headline_in", "Live Hero Headline Customizer (syncs across Overview & Lab)", 13.0, #94a3b8),
    );
    right_items = vec_push(right_items, w_input("in_headline", s.headline, "input_headline", input_style));
    right_items = vec_push(
        right_items,
        w_text(
            "lbl_wgsl_sig",
            "WGSL Signature: knr_hero_nebula(uv: Vec2, time: f64, mouse: Vec2, energy: f64, hue_shift: f64) -> Color",
            12.0,
            #64748b,
        ),
    );
    let right_card = w_card("lab_preset_card", style_glass(), right_items);

    let controls_grid_items: vec[Widget] = vec_new();
    controls_grid_items = vec_push(controls_grid_items, left_card);
    controls_grid_items = vec_push(controls_grid_items, right_card);
    let controls_grid = w_grid("shader_controls_grid", 2, style_gap(style_default(), 18.0), controls_grid_items);

    let tab_items: vec[Widget] = vec_new();
    tab_items = vec_push(tab_items, lab_card);
    tab_items = vec_push(tab_items, controls_grid);
    return w_col("tab_view_shaders", style_gap(style_default(), 20.0), tab_items);
}

// ============================================================================
// 7. TAB 2 — LINEAR SAFETY (&T Borrows, Match, Effects, < 100 us Verifier)
// ============================================================================

fn view_tab_safety(s: &State) -> Widget {
    let intro_items: vec[Widget] = vec_new();
    intro_items = vec_push(
        intro_items,
        w_badge("safety_badge", "STATICALLY VERIFIED LINEAR SSA · ZERO GARBAGE COLLECTION", #0f172aee, #34d399),
    );
    intro_items = vec_push(
        intro_items,
        w_bold_text("safety_title", "Memory Safety Without GC or Lifetime Gymnastics", 30.0, 800, #f8fafc),
    );
    intro_items = vec_push(
        intro_items,
        w_text(
            "safety_desc",
            "Every linear value in knr has a single owner tracked across the SSA control-flow graph. Safe declarative structs and collections auto-drop at scope exit, while unmanaged buffers and channels cannot leak. Current state headline '" + s.headline + "' is rendered via a zero-copy &State borrow.",
            15.0,
            #cbd5e1,
        ),
    );
    let intro_card = w_card("safety_intro", style_hero_glass(), intro_items);

    let cards: vec[Widget] = vec_new();
    cards = vec_push(
        cards,
        w_info_card(
            "safe_borrows",
            "SECOND-CLASS &T",
            #0c4a6eaa,
            #38bdf8,
            "Second-Class Borrows (&T)",
            "Pass &State to view(s: &State) -> Widget and nested helper views without moving ownership. Borrowed parameters are strictly read-only and cannot be returned, moved, freed, or stored in structs — zero lifetime syntax required.",
            "Statically rejects BorrowEscape",
        ),
    );
    cards = vec_push(
        cards,
        w_info_card(
            "safe_match",
            "ALGEBRAIC TYPES",
            #312e81aa,
            #a5b4fc,
            "Exhaustive match & Tagged Enums",
            "Algebraic enum declarations lower directly to compact tagged linear schemas with discriminant slot 0. Every match expression and statement is verified exhaustive at compile time with zero runtime surprises.",
            "Zero unhandled variants · Zero nulls",
        ),
    );
    cards = vec_push(
        cards,
        w_info_card(
            "safe_effects",
            "CAPABILITY ISOLATION",
            #064e3baa,
            #34d399,
            "Explicit Effect Isolation",
            "Functions are pure by default. Host capabilities — effects(Net, Ui, Hw, Async) — are checked transitively across every call edge. Pure business logic, MVU updates, and GPU shader fn kernels are guaranteed side-effect free.",
            "100% deterministic mocked testing",
        ),
    );
    cards = vec_push(
        cards,
        w_info_card(
            "safe_verifier",
            "SUB-100 US CHECK",
            #4c1d95aa,
            #c4b5fd,
            "< 100 us Static Verification",
            "A single fast verification pass validates SSA dominance, types, linear ownership, borrow escape, effect signatures, and naga WGSL/GLSL GPU purity in microseconds — emitting machine-readable JSON diagnostics.",
            "fix_hint · source_variable · alive_registers",
        ),
    );
    let safety_grid = w_grid("safety_cards_grid", 2, style_gap(style_default(), 18.0), cards);

    let inv_items: vec[Widget] = vec_new();
    inv_items = vec_push(
        inv_items,
        w_stat_card("inv_uam", "UseAfterMove", "Caught statically with exact moved_line & alive set", #f472b6),
    );
    inv_items = vec_push(
        inv_items,
        w_stat_card("inv_leak", "LinearLeak", "Every owned resource is consumed, returned, or auto-dropped", #34d399),
    );
    inv_items = vec_push(
        inv_items,
        w_stat_card("inv_esc", "BorrowEscape", "Borrowed &T refs never outlive their lexical call frame", #38bdf8),
    );
    let inv_grid = w_grid("safety_invariants", 3, style_gap(style_default(), 16.0), inv_items);

    let tab_items: vec[Widget] = vec_new();
    tab_items = vec_push(tab_items, intro_card);
    tab_items = vec_push(tab_items, safety_grid);
    tab_items = vec_push(tab_items, inv_grid);
    return w_col("tab_view_safety", style_gap(style_default(), 20.0), tab_items);
}

