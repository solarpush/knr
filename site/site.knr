// ============================================================================
// 9. ROOT DECLARATIVE VIEW (`fn view(s: &State) -> Widget`)
// ============================================================================

fn view_active_tab(s: &State) -> Widget {
    if s.active_tab == 0 {
        return view_tab_overview(&s);
    }
    if s.active_tab == 1 {
        return view_tab_shaders(&s);
    }
    if s.active_tab == 2 {
        return view_tab_safety(&s);
    }
    return view_tab_toolchain(&s);
}

fn view(s: &State) -> Widget {
    let shell_items: vec[Widget] = vec_new();
    shell_items = vec_push(shell_items, view_navbar(&s));
    shell_items = vec_push(shell_items, view_active_tab(&s));
    shell_items = vec_push(shell_items, view_footer(&s));

    let shell = w_col(
        "site_shell",
        Style {
            w: -1.0,
            max_w: 1180.0,
            gap_x: 20.0,
            gap_y: 20.0,
            ..style_default()
        },
        shell_items,
    );

    let root_items: vec[Widget] = vec_new();
    root_items = vec_push(root_items, shell);

    return w_col(
        "site_root",
        Style {
            bg: "radial(#172554, #0b1120)",
            align: "center",
            pad_t: 24.0,
            pad_r: 24.0,
            pad_b: 36.0,
            pad_l: 24.0,
            ..style_default()
        },
        root_items,
    );
}

// ============================================================================
// 10. BUILT-IN DETERMINISTIC UNIT TESTS (`knr test site/site.knr`)
// ============================================================================

fn test_site_init_and_navigation() -> bool {
    let s = init();
    let init_ok = s.active_tab == 0 && s.energy > 0.7 && s.hue_shift > 0.1 && s.preset_name == "Cyber Cyan";
    let v0 = view(&s);
    let ok0 = v0.kind == "col" && v0.key == "site_root";

    s = update(s, "tab_shaders");
    let v1 = view(&s);
    let ok1 = s.active_tab == 1 && v1.kind == "col";

    s = update(s, "tab_safety");
    let v2 = view(&s);
    let ok2 = s.active_tab == 2 && v2.kind == "col";

    s = update(s, "tab_toolchain");
    let v3 = view(&s);
    let ok3 = s.active_tab == 3 && v3.kind == "col";

    s = update(s, "tab_overview");
    let ok_back = s.active_tab == 0;

    return init_ok && ok0 && ok1 && ok2 && ok3 && ok_back;
}

fn test_site_shader_controls_and_tick() -> bool {
    let s = init();
    s = tick(s, 0.016, 0.016);
    s = tick(s, 0.500, 0.516);
    let tick_ok = s.elapsed > 0.5 && s.pulse >= 0.0 && s.pulse <= 1.0;

    let prev_elapsed = s.elapsed;
    s = update(s, "toggle_pause");
    s = tick(s, 1.0, 1.516);
    let pause_ok = s.paused && s.elapsed == prev_elapsed;
    s = update(s, "toggle_pause");
    let unpause_ok = !s.paused;

    s = on_slider(s, "slider_energy", 0.94);
    s = on_slider(s, "slider_hue", 0.64);
    s = on_input(s, "input_headline", "Zero-GC Linear GPU");
    let controls_ok = s.energy > 0.90 && s.hue_shift > 0.60 && s.preset_name == "Custom" && s.headline == "Zero-GC Linear GPU";

    s = update(s, "preset_solar_violet");
    let p1_ok = s.preset_name == "Solar Violet" && s.energy > 0.85 && s.hue_shift > 0.45;

    s = update(s, "preset_deep_ocean");
    let p2_ok = s.preset_name == "Deep Ocean" && s.energy < 0.55 && s.hue_shift > 0.80;

    s = update(s, "preset_cyber_cyan");
    let p3_ok = s.preset_name == "Cyber Cyan" && s.energy > 0.65 && s.hue_shift < 0.20;

    s = update(s, "tab_shaders");
    let v = view(&s);
    let view_ok = v.kind == "col";

    return tick_ok && pause_ok && unpause_ok && controls_ok && p1_ok && p2_ok && p3_ok && view_ok;
}

fn test_site_hero_shader_cpu_parity() -> bool {
    let uv1 = Vec2 { x: 0.5, y: 0.5 };
    let m1 = Vec2 { x: 0.5, y: 0.5 };
    let c1 = knr_hero_nebula(uv1, 1.25, m1, 0.72, 0.12);

    let uv2 = Vec2 { x: 0.22, y: 0.78 };
    let m2 = Vec2 { x: 0.75, y: 0.30 };
    let c2 = knr_hero_nebula(uv2, 3.4, m2, 0.90, 0.52);

    let uv3 = Vec2 { x: 0.85, y: 0.18 };
    let m3 = Vec2 { x: 0.15, y: 0.85 };
    let c3 = knr_hero_nebula(uv3, 0.0, m3, 0.45, 0.85);

    let ok1 = c1.r >= 0.0 && c1.r <= 1.0 && c1.g >= 0.0 && c1.g <= 1.0 && c1.b >= 0.0 && c1.b <= 1.0 && c1.a == 1.0;
    let ok2 = c2.r >= 0.0 && c2.r <= 1.0 && c2.g >= 0.0 && c2.g <= 1.0 && c2.b >= 0.0 && c2.b <= 1.0 && c2.a == 1.0;
    let ok3 = c3.r >= 0.0 && c3.r <= 1.0 && c3.g >= 0.0 && c3.g <= 1.0 && c3.b >= 0.0 && c3.b <= 1.0 && c3.a == 1.0;
    let core_lit = c1.b > 0.15 || c1.g > 0.15;

    return ok1 && ok2 && ok3 && core_lit;
}
