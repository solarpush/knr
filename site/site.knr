// ============================================================================
// knr — Official Interactive Showcase & Landing Website (`site/site.knr`)
// 100% Pure `.knr` · Zero HTML · Zero CSS · Zero GLSL · Zero GC
// ============================================================================
// Run natively on GPU (`wgpu 23` Vulkan/Metal/DX12, auto CPU fallback):
//   knr run site/site.knr --gui
//   knr dev site/site.knr --gui
// Build standalone SSR + zero-import WASM + WebGPU / WebGL2 web bundle:
//   knr build site/site.knr --target web -o dist_site/
// Verify statically in < 100 us & run deterministic built-in tests:
//   knr check site/site.knr --graph
//   knr test site/site.knr

import "std/ui";

// ============================================================================
// 1. LIVE GPU HERO SHADER (`knr_hero_nebula`)
//    Statically verified GPU-pure (`knr-verify`) and compiled via `naga` to:
//    - WGSL (Desktop `wgpu` + Browser WebGPU)
//    - GLSL ES 3.00 (Universal Browser WebGL2 fallback)
//
//    Exact WGSL parameter bindings:
//      param 0 `uv: Vec2`       -> fragment UV `(0..1, 0..1)`
//      param 1 `time: f64`      -> elapsed seconds
//      param 2 `mouse: Vec2`    -> normalized pointer UV `(0..1, 0..1)`
//      param 3 `energy: f64`    -> `uniforms[0]`
//      param 4 `hue_shift: f64` -> `uniforms[1]`
// ============================================================================

fn nebula_cos(t: f64, phase: f64) -> f64 {
    return 0.5 + 0.5 * cos(6.2831853 * (t + phase));
}

shader fn knr_hero_nebula(uv: Vec2, time: f64, mouse: Vec2, energy: f64, hue_shift: f64) -> Color {
    let e = clamp(energy, 0.0, 1.0);
    let h = clamp(hue_shift, 0.0, 1.0);
    let t = time * (0.28 + e * 1.35);

    // Wide-aspect centered coordinates for deep cosmic framing
    let px = (uv.x - 0.5) * 2.1;
    let py = (uv.y - 0.5) * 1.25;
    let rad = sqrt(px * px + py * py);
    let ang = atan2(py + 0.0001, px + 0.0001);

    // Mouse-reactive glowing energy core + concentric plasma ripples
    let mx = (uv.x - mouse.x) * 1.9;
    let my = (uv.y - mouse.y) * 1.15;
    let mdist = sqrt(mx * mx + my * my);
    let core_glow = (0.042 + e * 0.068) / (mdist * mdist + 0.038);
    let core_halo = (0.14 + e * 0.14) / (mdist + 0.24);
    let ripple = smoothstep(0.35, 1.0, 0.5 + 0.5 * sin(mdist * 18.0 - t * 3.4)) * (0.12 / (mdist + 0.28));

    // Domain-warped aurora nebula curtains (cyan / indigo / violet)
    let warp_x = px + 0.28 * sin(py * 2.8 + t * 0.85) + 0.14 * cos(ang * 2.0 - t * 0.6);
    let warp_y = py + 0.24 * cos(px * 2.6 - t * 0.75) + 0.12 * sin(rad * 4.5 - t * 1.1);

    let wave1 = sin(warp_x * 3.4 + sin(warp_y * 2.9 - t * 0.9) + t * 0.65);
    let wave2 = cos(warp_y * 4.1 - warp_x * 2.3 + t * 0.95 + cos(rad * 3.6 + t * 0.4) * 0.5);
    let wave3 = sin((warp_x + warp_y) * 3.2 - t * 1.25 + ang * 1.5);

    let field = 0.5 + 0.5 * (wave1 * 0.46 + wave2 * 0.34 + wave3 * 0.20);
    let ribbon = smoothstep(0.18, 0.96, field);
    let veil = smoothstep(0.05, 0.85, 0.5 + 0.5 * sin(warp_x * 1.8 - warp_y * 2.4 + t * 0.45));

    // Subtle procedural starlight grid shimmer
    let shimmer = smoothstep(0.92, 1.0, sin(uv.x * 46.0 + t * 0.3) * cos(uv.y * 26.0 - t * 0.25));
    let aurora_amp = (0.38 + e * 0.85) * ribbon + 0.22 * veil;

    // Cosine spectral palette shifted continuously by `hue_shift`
    let pal_t = ribbon * 0.42 + veil * 0.20 + h + t * 0.035;
    let pr = nebula_cos(pal_t, 0.68);
    let pg = nebula_cos(pal_t, 0.16);
    let pb = nebula_cos(pal_t, 0.90);

    // Smooth vignette into deep obsidian backdrop
    let vig = clamp(1.12 - rad * 0.42, 0.32, 1.0);

    let base_r = lerp(0.025, 0.08 + aurora_amp * pr * 0.68, vig);
    let base_g = lerp(0.045, 0.09 + aurora_amp * pg * 0.82, vig);
    let base_b = lerp(0.115, 0.18 + aurora_amp * pb * 1.05, vig);

    let r = clamp(base_r + core_glow * (0.34 + 0.45 * pr) + core_halo * 0.16 + ripple * 0.45 + shimmer * 0.18, 0.0, 1.0);
    let g = clamp(base_g + core_glow * (0.62 + 0.30 * pg) + core_halo * 0.36 + ripple * 0.82 + shimmer * 0.26, 0.0, 1.0);
    let b = clamp(base_b + core_glow * 0.98 + core_halo * 0.58 + ripple * 0.96 + shimmer * 0.34, 0.0, 1.0);

    return Color { r: r, g: g, b: b, a: 1.0 };
}

// ============================================================================
// 2. MVU APPLICATION STATE, 60/120 FPS TICK, AND INTERACTIVE EVENT HANDLERS
// ============================================================================

schema State {
    0: active_tab i64,
    1: energy f64,
    2: hue_shift f64,
    3: paused bool,
    4: elapsed f64,
    5: pulse f64,
    6: headline str,
    7: preset_name str,
}

fn init() -> State {
    return State {
        active_tab: 0,
        energy: 0.72,
        hue_shift: 0.12,
        paused: false,
        elapsed: 0.0,
        pulse: 0.5,
        headline: "Linear Ownership. Zero GC. Native GPU.",
        preset_name: "Cyber Cyan",
    };
}

fn tick(s: State, dt: f64, _wall_elapsed: f64) -> State {
    let next_elapsed = if s.paused { s.elapsed } else { s.elapsed + dt };
    let next_pulse = ease_in_out_sine(0.5 + 0.5 * sin(next_elapsed * 2.2));
    return State {
        elapsed: next_elapsed,
        pulse: next_pulse,
        ..s
    };
}

fn update(s: State, action: str) -> State {
    if action == "tab_overview" {
        return State { active_tab: 0, ..s };
    }
    if action == "tab_shaders" {
        return State { active_tab: 1, ..s };
    }
    if action == "tab_safety" {
        return State { active_tab: 2, ..s };
    }
    if action == "tab_toolchain" {
        return State { active_tab: 3, ..s };
    }
    if action == "preset_cyber_cyan" {
        return State {
            energy: 0.72,
            hue_shift: 0.12,
            preset_name: "Cyber Cyan",
            ..s
        };
    }
    if action == "preset_solar_violet" {
        return State {
            energy: 0.90,
            hue_shift: 0.52,
            preset_name: "Solar Violet",
            ..s
        };
    }
    if action == "preset_deep_ocean" {
        return State {
            energy: 0.45,
            hue_shift: 0.85,
            preset_name: "Deep Ocean",
            ..s
        };
    }
    if action == "toggle_pause" {
        let next_paused = if s.paused { false } else { true };
        return State { paused: next_paused, ..s };
    }
    if action == "reset_defaults" {
        return State {
            energy: 0.72,
            hue_shift: 0.12,
            paused: false,
            headline: "Linear Ownership. Zero GC. Native GPU.",
            preset_name: "Cyber Cyan",
            ..s
        };
    }
    return s;
}

fn on_slider(s: State, action: str, val: f64) -> State {
    let v = clamp(val, 0.0, 1.0);
    if action == "slider_energy" {
        return State {
            energy: v,
            preset_name: "Custom",
            ..s
        };
    }
    if action == "slider_hue" {
        return State {
            hue_shift: v,
            preset_name: "Custom",
            ..s
        };
    }
    return s;
}

fn on_input(s: State, action: str, text: str) -> State {
    if action == "input_headline" {
        return State { headline: text, ..s };
    }
    return s;
}

