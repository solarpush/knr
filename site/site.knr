        bg: "linear(145, #111827dd, #0b1120ee)",
        color: #f8fafc,
        border: #334155aa,
        border_w: 1.0,
        r_tl: 20.0,
        r_tr: 20.0,
        r_br: 20.0,
        r_bl: 20.0,
        pad_t: 22.0,
        pad_r: 24.0,
        pad_b: 22.0,
        pad_l: 24.0,
        gap_x: 14.0,
        gap_y: 12.0,
        shadow_x: 0.0,
        shadow_y: 14.0,
        shadow_blur: 32.0,
        shadow_color: #00000077,
        backdrop_blur: 18.0,
        hover_border: #38bdf877,
        transition_ms: 160.0,
        ..style_card()
