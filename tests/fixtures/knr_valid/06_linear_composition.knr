// Valid 06: Nested linear composition (tree)
type LeafNode = {
    tag: string,
    text: string,
};

type CardNode = {
    title: string,
    children: LeafNode[],
};

function build_tree(): CardNode {
    const card: CardNode = {
        title: "Overview",
        children: [
            { tag: "h1", text: "Dashboard" },
            { tag: "p", text: "Status OK" },
        ],
    };
    return card;
}
