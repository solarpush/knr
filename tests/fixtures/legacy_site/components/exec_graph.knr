import "../schemas/vdom.ssa.schema";

function build_exec_graph(): Section {
    const banner: Card = {
        tag: "div", class: "sec-banner", text: "",
        children: [
            { tag: "div", class: "card-tag", text: "VISUALISEUR D'ARCHITECTURE & GRAPHE D'EXÉCUTION INTERACTIF (AST → VERIFY → WASM CFG / VM SSR → DOM)", action: "", target: "" },
            { tag: "h2", class: "sec-title", text: "Comment knr est Vérifié, Compilé et Exécuté dans le Navigateur", action: "", target: "" },
            { tag: "p", class: "sec-desc", text: "Cliquez sur l'un des 4 scénarios ci-dessous pour illuminer en direct le chemin d'exécution exact à travers les blocs basiques SSA (bb0, bb1, bb2), l'appel inter-fonction (call apply_step) et la boucle serveur SSR :", action: "", target: "" },
            { tag: "button", class: "btn trace-btn trace-inc", text: "▶ Simuler WASM +1 (op=1 : bb0 → bb2 → call apply_step)", action: "/trace/inc", target: ".trace-router" },
            { tag: "button", class: "btn btn-sec trace-btn trace-dec", text: "▶ Simuler WASM -1 (op=2 : bb0 → bb2 → call apply_step)", action: "/trace/dec", target: ".trace-router" },
            { tag: "button", class: "btn btn-sec trace-btn trace-reset", text: "▶ Simuler WASM Reset (op=0 : bb0 → bb1 → ret 0)", action: "/trace/reset", target: ".trace-router" },
            { tag: "button", class: "btn-emerald trace-btn trace-ssr", text: "▶ Simuler Cycle Complet Serveur HTTP SSR (/api/inc → VM → DOM)", action: "/trace/ssr", target: ".trace-router" },
        ],
    };

    const node_ast: Card = {
        tag: "article", class: "card exec-node node-ast", text: "",
        children: [
            { tag: "div", class: "card-tag", text: "ÉTAPE 1 • FRONTEND & CHARGEUR MULTI-FICHIERS (KNR-CORE)", action: "", target: "" },
            { tag: "h3", class: "card-title", text: "1. Résolution AST & Graphe Diamant", action: "", target: "" },
            { tag: "pre", class: "pre", text: "[schemas/vdom.ssa.schema] ──► (Leaf, Card, Section, Page)\n                                      │\n[site/client_state.ssa]  ─────────────┼──► Module AST Unifié\n[site/server.ssa]        ─────────────┘    • 0 Cycle d'import\n                                           • Schemas isolés du code", action: "", target: "" },
        ],
    };

    const node_verify: Card = {
        tag: "article", class: "card exec-node node-verify", text: "",
        children: [
            { tag: "div", class: "card-tag", text: "ÉTAPE 2 • JUGE STATIQUE (< 100 µs — KNR-VERIFY)", action: "", target: "" },
            { tag: "h3", class: "card-title", text: "2. Les 4 Passes de Vérification", action: "", target: "" },
            { tag: "pre", class: "pre", text: "┌─ Passe 1 : Assignation Unique Monotone (%0, %1, %2...)\n├─ Passe 2 : Machine Linéaire (Uninit → Alive → Moved)\n├─ Passe 3 : Inférence & Typage Strict (i64, str, struct)\n└─ Passe 4 : Isolation des Capacités effects(Ui, Net, Async)\n   ══► Résultat : 0 Diagnostic (Garanti sans GC ni fuite)", action: "", target: "" },
        ],
    };

    const node_bb0: Card = {
        tag: "article", class: "card exec-node node-bb0", text: "",
        children: [
            { tag: "div", class: "card-tag", text: "ÉTAPE 3 • ENTRÉE WEBASSEMBLY (SITE.WASM — KNR_DISPATCH BB0)", action: "", target: "" },
            { tag: "h3", class: "card-title", text: "3. Bloc d'Entrée CFG : bb0", action: "", target: "" },
            { tag: "pre", class: "pre", text: "fn knr_dispatch(%0: i64, %1: i64) -> i64 {\nbb0:                        // %0 = état actuel, %1 = code op\n    %2 = const_i64 0        // Registre %2 = 0 (Copy)\n    %3 = cmp_eq %1 %2       // Test : %1 (op) == 0 ?\n    br_if %3 bb1 bb2        // Branchement conditionnel CFG\n                            //   ├─ true  ──► saut vers bb1\n                            //   └─ false ──► saut vers bb2", action: "", target: "" },
        ],
    };

    const node_bb1: Card = {
        tag: "article", class: "card exec-node node-bb1", text: "",
        children: [
            { tag: "div", class: "card-tag", text: "ÉTAPE 4A • BRANCHE TRUE (OP == 0 : RESET IMMÉDIAT)", action: "", target: "" },
            { tag: "h3", class: "card-title", text: "4A. Bloc Terminateur : bb1", action: "", target: "" },
            { tag: "pre", class: "pre", text: "bb1:                        // Exécuté uniquement si op == 0\n    ret %2                  // Retourne %2 (0) directement\n\n┌─ État des Registres en sortie de bb1 ───────────────┐\n│ %0 (cur) : Copy   │ %1 (op=0) : Copy │ %2 : 0 (ret) │\n└─────────────────────────────────────────────────────┘", action: "", target: "" },
        ],
    };

    const node_bb2: Card = {
        tag: "article", class: "card exec-node node-bb2", text: "",
        children: [
            { tag: "div", class: "card-tag", text: "ÉTAPE 4B • BRANCHE FALSE (OP == 1 [+1] OU OP == 2 [-1])", action: "", target: "" },
            { tag: "h3", class: "card-title", text: "4B. Bloc Arithmétique & Call : bb2", action: "", target: "" },
            { tag: "pre", class: "pre", text: "bb2:                        // Exécuté si op == 1 ou op == 2\n    %4 = const_i64 3        // %4 = 3\n    %5 = const_i64 2        // %5 = 2\n    %6 = mul %1 %5          // si op=1 -> 2  | si op=2 -> 4\n    %7 = sub %4 %6          // si op=1 -> +1 | si op=2 -> -1\n    %8 = call apply_step %0 %7  // Appel 0x1E (Op::Call)\n    ret %8", action: "", target: "" },
        ],
    };

    const node_call: Card = {
        tag: "article", class: "card exec-node node-call", text: "",
        children: [
            { tag: "div", class: "card-tag", text: "ÉTAPE 5 • EXÉCUTION INTER-FONCTION WASM & MUTATION DOM", action: "", target: "" },
            { tag: "h3", class: "card-title", text: "5. apply_step & Pont DOM O(1)", action: "", target: "" },
            { tag: "pre", class: "pre", text: "fn apply_step(%0: i64, %1: i64) -> i64 {\nbb0:\n    %2 = add %0 %1          // Instruction Wasm native i64.add\n    ret %2                  // Retourne la nouvelle valeur\n}\n══► Pont UiPlatform : el.textContent = next (0 GC)", action: "", target: "" },
        ],
    };

    const node_ssr: Card = {
        tag: "article", class: "card exec-node node-ssr", text: "",
        children: [
            { tag: "div", class: "card-tag", text: "ÉTAPE 6 • EXÉCUTION SERVEUR SSR (KNR-INTERP + TOKIO NET/UI)", action: "", target: "" },
            { tag: "h3", class: "card-title", text: "6. Boucle d'Événements VM (site/server.ssa)", action: "", target: "" },
            { tag: "pre", class: "pre", text: "[Navigateur] fetch('/api/inc', {method: 'POST'})\n     │\n     ▼\n[VM bb1] %13 = syscall Net \"net.wait_req\" %1  (Auto-Refill Gas)\n[VM bb2] %17 = chan_recv %3 ──► %18 = add %17 1 ──► chan_send %3 %18\n[VM bb2] %24 = syscall Net \"net.respond\" %23  (HTTP 200 OK)\n     │\n     ▼\n[Navigateur] Mise à jour DOM instantanée + Console Télémétrie", action: "", target: "" },
        ],
    };

    return {
        tag: "section",
        class: "grid page-graph",
        text: "",
        children: [banner, node_ast, node_verify, node_bb0, node_bb1, node_bb2, node_call, node_ssr],
    };
}
